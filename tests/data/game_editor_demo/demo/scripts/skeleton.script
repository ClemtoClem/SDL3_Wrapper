# skeleton — patrouille entre patrol_min et patrol_max (axe Z)
class Squelette extends Behaviour {
    let heading = 1

    fn on_update(dt) {
        let p = this.position()
        let lo = this.prop("patrol_min")
        let hi = this.prop("patrol_max")
        let z = p[2] + this.heading * 1.2 * dt
        if (z > hi) {
            z = hi
            this.heading = -1
        }
        if (z < lo) {
            z = lo
            this.heading = 1
        }
        this.set_position(p[0], p[1], z)
        let facing = 0
        if (this.heading < 0) { facing = 180 }
        this.set_rotation(0, facing, math.sin(editor.time() * 6) * 4)
    }
}
