# torchlight — flamme vacillante (attaché à chaque torche)
# Propriétés lues sur le nœud : flicker_speed, flicker_min, flicker_max,
# seed, flame (nom de la flamme à animer).
class Torche extends Behaviour, Light3D {
    let base = 0

    fn prop_or(key, fallback) {
        let value = this.prop(key)
        if (value == nil) { return fallback }
        return value
    }

    fn on_start() {
        this.base = this.intensity()
    }

    fn on_update(dt) {
        let t = editor.time() * this.prop_or("flicker_speed", 1.5) + this.prop_or("seed", 0)
        # Somme de trois sinus incommensurables : un bruit sans motif visible.
        let n = (math.sin(t * 7.3) + math.sin(t * 13.1 + 1.7) * 0.5 + math.sin(t * 23.7 + 0.4) * 0.25) / 1.75
        let k = math.lerp(this.prop_or("flicker_min", 0.75), this.prop_or("flicker_max", 1.2), n * 0.5 + 0.5)
        this.set_intensity(this.base * k)
        let flame = this.prop("flame")
        if (flame != nil) {
            object.set_scale(flame, 1, 0.85 + k * 0.2, 1)
        }
    }
}
