# ── Scène « Laboratoire physique » : charge croissante du solveur ───────────

# Une caisse larguée : un objet visible (Mesh3D) avec un corps dynamique
# (PhysicsBody). Elle disparaît avec la scène — ou plus tôt, par destroy().
class Caisse extends Mesh3D, PhysicsBody {
    fn init(numero) {
        let angle = numero * 0.7
        super.init("Caisse " .. numero, {
            shape: "box",
            size: [0.9, 0.9, 0.9],
            pos: [math.cos(angle) * 2.5, 9 + numero * 0.4, math.sin(angle) * 2.5],
            color: [80 + numero * 6, 200 - numero * 5, 120],
            material: "plastic",
            body: "dynamic",
            mass: 1.5,
            restitution: 0.25,
            friction: 0.6,
            tag: "debris"
        })
    }
}

class Laboratoire extends Scene {
    let t = 0
    let dropped = 0
    let max_drops = 24
    let next_drop = 0.35
    let caisses = []

    fn on_start() {
        editor.log("Laboratoire : largage de " .. this.max_drops .. " caisses")
    }

    fn on_update(dt) {
        this.t += dt
        if (this.dropped >= this.max_drops or this.t < this.next_drop) { return nil }
        this.next_drop = this.t + 0.35
        this.dropped += 1
        this.caisses.append(Caisse(this.dropped))
        if (this.dropped == this.max_drops) {
            editor.log("Largage terminé : " .. scene.count() .. " objets dans la scène")
        }
    }
}
