# player — contrôleur à la première personne
# Le corps est une capsule physique : on lui donne une vitesse (PhysicsBody),
# la physique gère murs et sol.
class Joueur extends Behaviour, PhysicsBody {
    let yaw = 0
    let pitch = 0
    let manual = false
    let waypoints = []
    let next_point = 0
    let walk_speed = 4

    fn wrap_angle(a) {
        while (a > math.pi) { a -= 2 * math.pi }
        while (a < -math.pi) { a += 2 * math.pi }
        return a
    }

    fn on_start() {
        this.waypoints = scene.find_tag("waypoint")
    }

    fn on_update(dt) {
        let mouse = input.mouse_delta()
        if (mouse[0] != 0 or mouse[1] != 0) { this.manual = true }
        this.yaw += mouse[0] * 0.0025
        this.pitch = math.clamp(this.pitch - mouse[1] * 0.0025, -1.2, 1.2)

        let forward = input.axis("s", "w") + input.axis("down", "up")
        let strafe = input.axis("a", "d") + input.axis("left", "right")
        if (forward != 0 or strafe != 0) { this.manual = true }

        # Visite guidée : cap vers le prochain point, en avant toute.
        if (not this.manual and this.next_point < len(this.waypoints)) {
            let here = this.position()
            let there = object.position(this.waypoints[this.next_point])
            let dx = there[0] - here[0]
            let dz = there[2] - here[2]
            if (dx * dx + dz * dz < 0.5) {
                this.next_point += 1
            } else {
                this.yaw += math.clamp(this.wrap_angle(math.atan2(dx, dz) - this.yaw), -2.5 * dt, 2.5 * dt)
                forward = 1
            }
            this.pitch = math.lerp(this.pitch, 0, math.min(1, dt * 2))
        }

        let speed = this.walk_speed
        if (input.key("shift")) { speed = this.walk_speed * 1.8 }
        let v = this.velocity()
        let vy = 0
        if (v) { vy = v[1] }
        # Droite = (-cos, 0, sin) quand l'avant est (sin, 0, cos).
        let vx = (math.sin(this.yaw) * forward - math.cos(this.yaw) * strafe) * speed
        let vz = (math.cos(this.yaw) * forward + math.sin(this.yaw) * strafe) * speed
        this.set_velocity(vx, vy, vz)
        this.set_rotation(0, this.yaw * 180 / math.pi, 0)
        let eye = this.prop("eye")
        if (eye != nil) { object.set_rotation(eye, -this.pitch * 180 / math.pi, 0, 0) }
    }
}
