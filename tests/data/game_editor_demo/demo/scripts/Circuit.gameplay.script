# ── Scène « Circuit » : voiture pilotable + tours chronométrés ──────────────

# La voiture : un nœud de la scène (« Voiture ») piloté par un modèle
# « arcade » — le script tient le cap et la vitesse, la physique s'occupe de
# la gravité et des collisions avec les barrières.
class Voiture extends Behaviour, PhysicsBody {
    let heading = math.pi / 2  # radians, 0 = +Z ; départ tangent à la piste (+X)
    let speed = 0              # unités / seconde
    let max_speed = 26
    let accel = 14
    let brake = 22
    let drag = 3.5
    let turn_rate = 2.0        # radians / seconde à pleine vitesse

    # Avance d'un pas : `throttle` et `steer` dans [-1, 1].
    fn drive(throttle, steer, dt) {
        if (throttle > 0) {
            this.speed += this.accel * throttle * dt
        } else if (throttle < 0) {
            this.speed += this.brake * throttle * dt
        }
        this.speed -= this.drag * dt
        this.speed = math.clamp(this.speed, -6, this.max_speed)

        # On ne braque qu'en roulant (comme une vraie voiture à l'arrêt).
        let grip = math.clamp(math.abs(this.speed) / 8, 0, 1)
        this.heading += steer * this.turn_rate * grip * dt * math.sign(this.speed)

        let current = this.velocity()
        let vy = 0
        if (current) { vy = current[1] }
        this.set_velocity(math.sin(this.heading) * this.speed, vy, math.cos(this.heading) * this.speed)
        this.set_rotation(0, math.deg(this.heading), 0)
    }

    # Cap à suivre pour rejoindre un point : atan2 du vecteur voiture → cible.
    fn heading_to(target) {
        let here = this.position()
        let there = object.position(target)
        if (not here or not there) { return this.heading }
        return math.atan2(there[0] - here[0], there[2] - here[2])
    }
}

# Écart angulaire ramené dans [-pi, pi] : sans ce repliement, un cap qui
# franchit ±pi ferait braquer la voiture dans le mauvais sens pendant un tour
# complet.
fn wrap_angle(a) {
    while (a > math.pi) { a -= 2 * math.pi }
    while (a < -math.pi) { a += 2 * math.pi }
    return a
}

class Circuit extends Scene {
    let car = nil
    let checkpoints = []
    let next_checkpoint = 0
    let lap = 0
    let total_laps = 0
    let lap_time = 0
    let best_lap = 0
    let elapsed = 0
    let manual = false

    fn on_start() {
        this.car = Voiture("Voiture")
        this.checkpoints = scene.find_tag("checkpoint")
        # Le premier point est SOUS la voiture au départ : viser celui d'après,
        # sinon il serait validé à la première image et le premier tour serait
        # compté pour rien.
        if (len(this.checkpoints) > 1) { this.next_checkpoint = 1 }
        editor.log("Circuit : " .. len(this.checkpoints) .. " points de passage")
        editor.status("Circuit prêt — ZQSD/WASD pour conduire, sinon pilote automatique")
    }

    fn autopilot_steer() {
        if (len(this.checkpoints) == 0) { return 0 }
        let wanted = this.car.heading_to(this.checkpoints[this.next_checkpoint])
        return math.clamp(wrap_angle(wanted - this.car.heading) * 1.8, -1, 1)
    }

    fn on_update(dt) {
        this.elapsed += dt
        this.lap_time += dt

        let throttle = input.axis("down", "up") + input.axis("s", "w")
        let steer = input.axis("left", "right") + input.axis("a", "d")
        if (throttle != 0 or steer != 0) { this.manual = true }
        if (not this.manual) {
            steer = this.autopilot_steer()
            throttle = 1
        }
        this.car.drive(throttle, steer, dt)
        this.check_progress()
    }

    fn check_progress() {
        if (len(this.checkpoints) == 0) { return nil }
        let target = this.checkpoints[this.next_checkpoint]
        if (object.distance(this.car.node(), target) < 6.5) {
            this.next_checkpoint += 1
            if (this.next_checkpoint >= len(this.checkpoints)) {
                this.next_checkpoint = 0
                this.lap += 1
                this.total_laps = this.lap
                if (this.best_lap == 0 or this.lap_time < this.best_lap) { this.best_lap = this.lap_time }
                editor.log(format("Tour {} bouclé en {} s (meilleur : {} s)", this.lap,
                                  i64(this.lap_time * 100) / 100, i64(this.best_lap * 100) / 100))
                editor.status(format("Tour {} — meilleur {} s", this.lap, i64(this.best_lap * 100) / 100))
                this.lap_time = 0
            }
        }
    }
}
