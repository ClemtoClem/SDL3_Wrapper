# chest — ouvre le couvercle (propriété `lid`) quand `open` est vrai
class Coffre extends Behaviour {
    let angle = 0

    fn on_update(dt) {
        if (this.prop("open") == true and this.angle < 105) {
            this.angle = math.min(105, this.angle + dt * 80)
            object.set_rotation(this.prop("lid"), -this.angle, 0, 0)
        }
    }
}
