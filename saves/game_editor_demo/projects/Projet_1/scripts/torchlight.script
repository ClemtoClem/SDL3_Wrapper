# ── Torche : flamme vacillante (attachée à chaque torche des pièces) ─────────
# Propriétés lues sur le nœud : flicker_speed, flicker_min, flicker_max,
# seed (sinon tirée de la position), flame (nom de l'ENFANT flamme). Les pièces étant instanciées
# plusieurs fois, la flamme se désigne par son chemin sous la torche
# (`this.child(nom)`) : chaque torche anime la sienne.
class Torche extends Behaviour, Light3D {
    let base = 0
    let flamme = nil

    fn reglage(clef, defaut) {
        let valeur = this.prop(clef)
        if (valeur == nil) { return defaut }
        return valeur
    }

    let phase = 0

    fn on_start() {
        this.base = this.intensity()
        # Sans `seed` (torche de l'objet « torche », posée en instances), la
        # phase vient de la position : deux torches ne vacillent pas ensemble.
        let p = this.world_position()
        this.phase = this.reglage("seed", p[0] * 0.73 + p[2] * 1.31)
        let nom = this.prop("flame")
        if (nom != nil) { this.flamme = this.child(nom) }
    }

    fn on_update(dt) {
        let t = editor.time() * this.reglage("flicker_speed", 1.5) + this.phase
        # Somme de trois sinus incommensurables : un bruit sans motif visible.
        let n = (math.sin(t * 7.3) + math.sin(t * 13.1 + 1.7) * 0.5 + math.sin(t * 23.7 + 0.4) * 0.25) / 1.75
        let k = math.lerp(this.reglage("flicker_min", 0.75), this.reglage("flicker_max", 1.2), n * 0.5 + 0.5)
        this.set_intensity(this.base * k)
        if (this.flamme != nil) { object.set_scale(this.flamme, 1, 0.85 + k * 0.2, 1) }
    }
}
