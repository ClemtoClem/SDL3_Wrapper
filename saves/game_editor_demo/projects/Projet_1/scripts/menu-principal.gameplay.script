# ── Menu-principal : graine du donjon et difficulté ──────────────────────────

const DIFFICULTES = ["Facile", "Normal", "Difficile"]

# Le crâne du décor oscille doucement.
class Oscillation extends Behaviour {
    let temps = 0
    fn on_update(dt) {
        this.temps += dt
        this.set_rotation(0, math.sin(this.temps * 0.8) * 25, 0)
    }
}

class MenuPrincipal extends Scene {
    let graine = 1234
    let difficulte = "Normal"
    let champ = nil
    let boutons = []

    fn choisir(d) {
        this.difficulte = d
        for (b in this.boutons) {
            if (b.text == d) { b.set_bg("#8a2f2f") } else { b.set_bg("#2a2a32") }
        }
    }

    fn graine_au_hasard() {
        this.graine = i64(std.os.time() * 1000) % 100000
        this.champ.text = str(this.graine)
    }

    fn entrer() {
        let saisie = num(this.champ.text)
        if (saisie) { this.graine = i64(saisie) }
        let etat = this.state()
        etat.graine = this.graine
        etat.difficulte = this.difficulte
        etat.etage_depart = 0
        editor.log(format("Donjon : graine {}, difficulté {}", this.graine, this.difficulte))
        this.load("Génération")
    }

    fn on_start() {
        # Menu : souris libre, même en plein écran, pour cliquer les boutons.
        input.set_mouse_mode("free")
        Oscillation("Crâne")
        let etat = this.state()
        this.graine = etat.graine or 1234
        this.difficulte = etat.difficulte or "Normal"
        ui.label("LES CRYPTES DE SCRIPT", {anchor: "top_left", offset: [36, 26], font_size: 46, bold: true,
                                           color: "#e8c27a"})
        ui.label("Un donjon différent à chaque graine", {anchor: "top_left", offset: [40, 84], font_size: 17,
                                                         color: "#c9bfae"})

        let panneau = ui.column({anchor: "bottom_right", offset: [-40, -44], gap: 10, pad: 24, bg: "#120e0ce0",
                                 radius: 10, w: 360})
        ui.label("Graine du donjon", {parent: panneau, bold: true})
        let ligne = ui.row({parent: panneau, gap: 8})
        this.champ = ui.input("nombre", fn(w, texte) { this.entrer() }, {parent: ligne, w: 160})
        this.champ.text = str(this.graine)
        ui.button("Au hasard", fn(b) { this.graine_au_hasard() }, {parent: ligne, w: 110})
        ui.label("Difficulté", {parent: panneau, bold: true})
        let choix = ui.row({parent: panneau, gap: 6})
        for (d in DIFFICULTES) {
            this.boutons.append(ui.button(d, fn(b) { this.choisir(d) }, {parent: choix, w: 90}))
        }
        this.choisir(this.difficulte)
        ui.separator({parent: panneau})
        ui.button("Entrer dans le donjon", fn(b) { this.entrer() }, {parent: panneau, w: 300})
        ui.button("Scénario : les égouts", fn(b) { this.load("Égouts") }, {parent: panneau, w: 300})
        ui.button("Quitter", fn(b) { this.quit() }, {parent: panneau, w: 300})
        ui.label("ZQSD / WASD + souris : explorer · Espace ou clic : frapper · F7 : libérer la souris",
                 {anchor: "bottom", offset: [0, -18], font_size: 13, color: "#c9bfaea0"})
    }

    fn on_update(dt) {
        if (input.key("enter")) { this.entrer() }
    }
}
