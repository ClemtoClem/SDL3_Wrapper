# ── Joueur : contrôleur à la première personne ───────────────────────────────
#
# Souris (capturée) : regarder ; ZQSD / WASD ou flèches : marcher ; Maj :
# courir. Le corps est une capsule physique : on lui donne une vitesse, la
# physique gère murs et sol. Sans joueur, visite guidée : le chevalier suit
# les étapes (nœuds étiquetés « etape », posés par le script du donjon) et
# se tourne vers la cible que ce script lui désigne (propriété `cible`).
let yaw = 0
let pitch = 0
let manuel = false
let etapes = []
let prochaine = 0
let vitesse = 4

fn wrap_angle(a) {
    while (a > math.pi) { a -= 2 * math.pi }
    while (a < -math.pi) { a += 2 * math.pi }
    return a
}

fn on_start(self) {
    etapes = scene.find_tag("etape")
    prochaine = 0
    let r = object.rotation(self)
    yaw = 0
    if (r) { yaw = r[1] * math.pi / 180 }
    pitch = 0
    manuel = false
    node.prop(self, "manuel", false)
}

fn viser(self, cible, dt) {
    let ici = object.position(self)
    let la = object.position(cible)
    if (not ici or not la) { return nil }
    yaw += math.clamp(wrap_angle(math.atan2(la[0] - ici[0], la[2] - ici[2]) - yaw), -4 * dt, 4 * dt)
}

fn on_update(self, dt) {
    let souris = input.mouse_delta()
    if (souris[0] != 0 or souris[1] != 0) { manuel = true }
    # Repère direct : la droite de l'écran est −x quand on regarde +z, donc
    # tourner à droite fait DÉCROÎTRE le lacet.
    yaw -= souris[0] * 0.0025
    pitch = math.clamp(pitch - souris[1] * 0.0025, -1.2, 1.2)

    let avant = input.axis("s", "w") + input.axis("s", "z") + input.axis("down", "up")
    let cote = input.axis("a", "d") + input.axis("q", "d") + input.axis("left", "right")
    avant = math.clamp(avant, -1, 1)
    cote = math.clamp(cote, -1, 1)
    if (avant != 0 or cote != 0) { manuel = true }
    node.prop(self, "manuel", manuel)

    # Visite guidée : cap vers la prochaine étape ; halte pour combattre.
    if (not manuel) {
        let cible = node.prop(self, "cible")
        if (cible != nil and cible != "") {
            viser(self, cible, dt)
        } else if (prochaine < len(etapes)) {
            let ici = object.position(self)
            let la = object.position(etapes[prochaine])
            let dx = la[0] - ici[0]
            let dz = la[2] - ici[2]
            if (dx * dx + dz * dz < 0.6) {
                prochaine += 1
            } else {
                yaw += math.clamp(wrap_angle(math.atan2(dx, dz) - yaw), -3 * dt, 3 * dt)
                avant = 1
            }
        }
        pitch = math.lerp(pitch, -0.05, math.min(1, dt * 2))
    }

    let v = vitesse
    if (input.key("shift")) { v = vitesse * 1.8 }
    let actuelle = object.velocity(self)
    let vy = 0
    if (actuelle) { vy = actuelle[1] }
    # Droite = (−cos, 0, sin) quand l'avant est (sin, 0, cos).
    let vx = (math.sin(yaw) * avant - math.cos(yaw) * cote) * v
    let vz = (math.cos(yaw) * avant + math.sin(yaw) * cote) * v
    object.set_velocity(self, vx, vy, vz)
    object.set_rotation(self, 0, yaw * 180 / math.pi, 0)
    let oeil = node.prop(self, "eye")
    if (oeil != nil) { object.set_rotation(oeil, -pitch * 180 / math.pi, 0, 0) }
}
