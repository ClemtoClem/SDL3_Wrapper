# ── Génération : le plan du donjon, en cases de pièces interconnectables ─────
#
# Le donjon est une grille de CASES ; chaque case recevra une pièce
# (scenes/pieces/*.scene) dont les ouvertures sont centrées sur ses côtés.
#  1. un labyrinthe parfait (parcours en profondeur au hasard) relie toutes
#     les cases, puis quelques passages en plus créent des boucles ;
#  2. l'entrée est une case du bord, la sortie la case la plus éloignée à
#     pied (parcours en largeur) ;
#  3. chaque case reçoit sa pièce : entrée, sortie, salles aux culs-de-sac
#     et çà et là, couloirs ailleurs — le couloir choisi est celui dont les
#     ouvertures, une fois TOURNÉ de k × 90°, coïncident avec la case ;
#  4. squelettes et coffres sont répartis ; le donjon est baptisé.
# Le plan passe à la scène « Donjon » par game.state().plan.

const DIRS = [[0, 1], [1, 0], [0, -1], [-1, 0]]        # nord (+z), est, sud, ouest
const TAILLES = {"Facile": [4, 4], "Normal": [5, 5], "Difficile": [6, 6]}
const SQUELETTES = {"Facile": 3, "Normal": 6, "Difficile": 10}
# Couloirs : ouvertures du modèle (nord, est, sud, ouest).
const COULOIRS = [
    {piece: "carrefour", ouvert: [true, true, true, true]},
    {piece: "couloir_t", ouvert: [true, true, false, true]},
    {piece: "couloir_droit", ouvert: [true, false, true, false]},
    {piece: "couloir_angle", ouvert: [true, true, false, false]},
    {piece: "cul_de_sac", ouvert: [true, false, false, false]},
]
const SALLES_AU_BOUT = ["salle_tresor", "crypte", "salle_garde", "salle_tresor", "crypte"]
const NOMS = ["valdrakar", "morthelion", "sombrevault", "karnethys", "ulmgard", "vorhaven", "nekrolis", "thalgrim",
              "ossuaria", "grimbaldor"]

var progression = 0.0
var etape = "Préparation"
var journal = []
let tache = nil
let temps = 0
let parti = false
let barre = nil
let texte = nil
let lignes = nil

fn noter(message) {
    etape = message
    journal.append(message)
}

# Ouvertures `ouvert` tournées de k quarts de tour : le côté s devient s + k.
fn tourner(ouvert, k) {
    let r = [false, false, false, false]
    for (s in range(4)) { r[(s + k) % 4] = ouvert[s] }
    return r
}

fn memes(a, b) {
    for (s in range(4)) { if (a[s] != b[s]) { return false } }
    return true
}

fn degre(ouvert) {
    let n = 0
    for (o in ouvert) { if (o) { n += 1 } }
    return n
}

# Couloir et rotation pour des ouvertures données.
fn couloir_pour(ouvert) {
    for (c in COULOIRS) {
        for (k in range(4)) {
            if (memes(tourner(c.ouvert, k), ouvert)) { return [c.piece, k] }
        }
    }
    return ["carrefour", 0]
}

async fn generer(graine, difficulte) {
    let rng = math.random_engine(graine)
    let taille = TAILLES[difficulte] or [5, 5]
    let w = taille[0]
    let h = taille[1]
    let ouvert = []
    for (i in range(w * h)) { ouvert.append([false, false, false, false]) }
    fn relier(x, y, d) {
        ouvert[y * w + x][d] = true
        ouvert[(y + DIRS[d][1]) * w + x + DIRS[d][0]][(d + 2) % 4] = true
    }
    fn dedans(x, y) { return x >= 0 and y >= 0 and x < w and y < h }

    noter(format("Tracé d'un labyrinthe de {} × {} cases…", w, h))
    let depart = [rng.int(0, w - 1), 0]
    let vu = []
    for (i in range(w * h)) { vu.append(false) }
    let pile = [depart]
    vu[depart[1] * w + depart[0]] = true
    while (len(pile) > 0) {
        let c = pile[len(pile) - 1]
        let choix = []
        for (d in range(4)) {
            let nx = c[0] + DIRS[d][0]
            let ny = c[1] + DIRS[d][1]
            if (dedans(nx, ny) and not vu[ny * w + nx]) { choix.append(d) }
        }
        if (len(choix) == 0) {
            pile.pop()
        } else {
            let d = choix[rng.int(0, len(choix) - 1)]
            relier(c[0], c[1], d)
            let n = [c[0] + DIRS[d][0], c[1] + DIRS[d][1]]
            vu[n[1] * w + n[0]] = true
            pile.append(n)
        }
    }
    progression = 0.25
    sleep(250)

    noter("Percement de passages secondaires…")
    let boucles = 0
    for (y in range(h)) {
        for (x in range(w)) {
            for (d in [0, 1]) {
                let nx = x + DIRS[d][0]
                let ny = y + DIRS[d][1]
                if (dedans(nx, ny) and not ouvert[y * w + x][d] and rng.bool(0.12)) {
                    relier(x, y, d)
                    boucles += 1
                }
            }
        }
    }
    progression = 0.4
    sleep(250)

    noter(format("{} boucles ; recherche de la sortie la plus lointaine…", boucles))
    let distance = []
    let precedent = []
    for (i in range(w * h)) {
        distance.append(-1)
        precedent.append(-1)
    }
    let file = [depart[1] * w + depart[0]]
    distance[file[0]] = 0
    let tete = 0
    while (tete < len(file)) {
        let i = file[tete]
        tete += 1
        let x = i % w
        let y = i32(i / w)
        for (d in range(4)) {
            if (ouvert[i][d]) {
                let j = (y + DIRS[d][1]) * w + x + DIRS[d][0]
                if (distance[j] < 0) {
                    distance[j] = distance[i] + 1
                    precedent[j] = i
                    file.append(j)
                }
            }
        }
    }
    let sortie = 0
    for (i in range(w * h)) { if (distance[i] > distance[sortie]) { sortie = i } }
    let chemin = [sortie]
    while (precedent[chemin[0]] >= 0) { chemin.insert(0, precedent[chemin[0]]) }
    progression = 0.55
    sleep(250)

    noter("Choix et orientation des pièces…")
    let cases = []
    let salles = 0
    let debut = depart[1] * w + depart[0]
    for (i in range(w * h)) {
        let piece = ""
        let k = 0
        let salle = false
        let n = degre(ouvert[i])
        if (i == debut) {
            piece = "entree"
            salle = true
        } else if (i == sortie) {
            piece = "sortie"
            salle = true
        } else if (n == 1 and rng.bool(0.8)) {
            piece = SALLES_AU_BOUT[rng.int(0, len(SALLES_AU_BOUT) - 1)]
            salle = true
        } else if (n >= 2 and rng.bool(0.18)) {
            piece = "salle_piliers"
            if (rng.bool(0.4)) { piece = "salle_garde" }
            salle = true
        } else {
            let c = couloir_pour(ouvert[i])
            piece = c[0]
            k = c[1]
        }
        if (salle) {
            salles += 1
            k = rng.int(0, 3) # une salle a quatre portes : la tourner varie seulement le décor
        }
        cases.append({x: i % w, y: i32(i / w), ouvert: ouvert[i], piece: piece, rotation: k, salle: salle,
                      distance: distance[i]})
    }
    # Au moins une salle du trésor : la salle (ou, à défaut, la case) la plus
    # éloignée du chemin principal qui n'est ni l'entrée ni la sortie.
    let tresor = false
    for (c in cases) { if (c.piece == "salle_tresor") { tresor = true } }
    if (not tresor) {
        let choix = -1
        for (i in range(w * h)) {
            if (i != debut and i != sortie and cases[i].salle and (choix < 0 or degre(ouvert[i]) < degre(ouvert[choix]))) {
                choix = i
            }
        }
        if (choix < 0) {
            for (i in range(w * h)) { if (i != debut and i != sortie and degre(ouvert[i]) == 1) { choix = i } }
        }
        if (choix >= 0) {
            cases[choix].piece = "salle_tresor"
            cases[choix].salle = true
        }
    }
    progression = 0.7
    sleep(250)

    noter(format("{} salles, {} couloirs ; réveil des squelettes…", salles, w * h - salles))
    let monstres = []
    let voulu = SQUELETTES[difficulte] or 6
    let essais = 0
    while (len(monstres) < voulu and essais < 300) {
        essais += 1
        let i = rng.int(0, w * h - 1)
        if (distance[i] < 2) { continue } # pas au pied de l'escalier
        let c = cases[i]
        if (c.piece == "salle_garde" or c.salle or rng.bool(0.35)) {
            monstres.append([c.x, c.y, rng.float(-1.2, 1.2), rng.float(-1.2, 1.2)])
        }
    }
    progression = 0.85
    sleep(250)

    noter("Baptême du donjon…")
    let nom = gen.names(NOMS, 2, graine).generate(6, 10) or "Sans-Nom"
    progression = 1.0
    sleep(200)
    return {nom: "Crypte de " .. nom, graine: graine, difficulte: difficulte, largeur: w, hauteur: h, cases: cases,
            depart: [depart[0], depart[1]], sortie: [sortie % w, i32(sortie / w)], chemin: chemin,
            monstres: monstres}
}

fn on_start() {
    # Menu : souris libre, même en plein écran, pour cliquer les boutons.
    input.set_mouse_mode("free")
    let etat = game.state()
    let graine = etat.graine or 1234
    let difficulte = etat.difficulte or "Normal"
    let panneau = ui.column({anchor: "center", gap: 12, pad: 28, bg: "#120e0ce8", radius: 10, w: 520, align: "center"})
    ui.label("Génération du donjon", {parent: panneau, font_size: 30, bold: true, color: "#e8c27a"})
    ui.label(format("Graine {} · {}", graine, difficulte), {parent: panneau, color: "#c9bfae"})
    barre = ui.progress(0, 1, {parent: panneau, w: 440})
    texte = ui.label("Préparation", {parent: panneau, font_size: 15})
    lignes = ui.column({parent: panneau, gap: 2, align: "start", w: 440})
    tache = generer(graine, difficulte)
}

fn on_update(dt) {
    temps += dt
    object.set_rotation("Rune", 0, temps * 60, 0)
    barre.value = progression
    texte.text = etape
    if (len(lignes) < len(journal)) {
        ui.label("· " .. journal[len(lignes)], {parent: lignes, font_size: 12, color: "#9a917f"})
    }
    if (parti or not tache.done) { return nil }
    if (tache.failed) {
        texte.text = "La génération a échoué : " .. tache.error
        return nil
    }
    if (temps >= 2) {
        game.state().plan = tache.value
        parti = true
        game.load_scene("Donjon")
    }
}
