# ── Formes et matériaux : chaque primitive tourne sur son socle ──────────────
const demo = import "demo"

class FormesEtMateriaux extends demo.SceneDemo {
    let formes = []

    fn on_start() {
        this.afficher_titre("Formes et matériaux",
                            "Plastique, métal, bois, PBR et sans éclairage sur les sept primitives.", 380)
        this.formes = scene.find_tag("forme")
    }

    fn on_update(dt) {
        super.on_update(dt)
        let i = 0
        for (nom in this.formes) {
            i += 1
            object.set_rotation(nom, math.sin(this.temps + i) * 20, this.temps * (25 + i * 6), 0)
        }
    }
}
