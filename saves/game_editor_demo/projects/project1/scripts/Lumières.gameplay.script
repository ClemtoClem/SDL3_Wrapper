# ── Lumières : quatre lumières colorées tournent autour des colonnes ─────────
const demo = import "demo"

# Chaque lumière de la scène reçoit une Behaviour (posée par la scène) qui la
# fait orbiter ; Light3D donne accès à son intensité.
class Orbite extends Behaviour, Light3D {
    let rang = 0
    let temps = 0

    fn init(nom, rang) {
        super.init(nom)
        this.rang = rang
    }

    fn on_update(dt) {
        this.temps += dt
        let a = this.temps * 0.7 + this.rang * math.pi / 2
        this.set_position(math.cos(a) * 6, 2.2 + math.sin(this.temps * 2 + this.rang) * 0.8, math.sin(a) * 6)
    }
}

class Lumieres extends demo.SceneDemo {
    let orbites = []

    fn on_start() {
        let bandeau = this.afficher_titre("Lumières", "Lumières ponctuelles animées par script : position et intensité.",
                                          380)
        let rang = 0
        for (nom in light.list()) {
            this.orbites.append(Orbite(nom, rang))
            rang += 1
        }
        ui.label(format("{} lumières dans la scène", len(this.orbites)), {parent: bandeau, font_size: 12,
                                                                          color: "#9aa6b8"})
        let ligne = ui.row({parent: bandeau, gap: 8, align: "center"})
        ui.label("Intensité", {parent: ligne, font_size: 12})
        ui.slider(0.2, 4, 2.2, fn(w, v) {
            for (o in this.orbites) { o.set_intensity(v) }
        }, {parent: ligne, w: 200})
    }
}
