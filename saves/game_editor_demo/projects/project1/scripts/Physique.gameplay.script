# ── Physique : une pyramide de caisses, des sphères qu'on lâche dessus ───────
const demo = import "demo"

# Une sphère lâchée : objet visible (Mesh3D) doté d'un corps dynamique
# (PhysicsBody). Elle disparaît avec la scène, sans rien à écrire pour cela.
class Sphere extends Mesh3D, PhysicsBody {
    fn init(numero) {
        let x = math.sin(numero * 1.7) * 1.2
        super.init("Sphère " .. numero, {
            shape: "sphere", size: [0.9, 0.9, 0.9], pos: [x, 9, -0.4],
            color: [240 - numero * 7 % 120, 90, 60 + numero * 13 % 160], material: "pbr", metallic: 0.3,
            body: "dynamic", collider: "sphere", mass: 4, restitution: 0.55
        })
    }
}

class Physique extends demo.SceneDemo {
    let lachees = 0
    let attente = 0
    let compteur = nil
    let espace_avant = false
    let spheres = []

    fn on_start() {
        let bandeau = this.afficher_titre("Physique",
                                          "Espace (ou le bouton) : lâcher une sphère. Une toutes les 2 s sinon.", 380)
        this.compteur = ui.label("Sphères lâchées : 0", {parent: bandeau, font_size: 13})
        let boutons = ui.row({parent: bandeau, gap: 8})
        ui.button("Lâcher une sphère", fn(b) { this.lacher() }, {parent: boutons, w: 170})
        ui.button("Recommencer", fn(b) { this.load("Physique") }, {parent: boutons, w: 130})
    }

    fn lacher() {
        this.lachees += 1
        this.spheres.append(Sphere(this.lachees))
        this.compteur.text = format("Sphères lâchées : {}", this.lachees)
    }

    fn on_update(dt) {
        super.on_update(dt)
        this.attente += dt
        let espace = input.key("space")
        if (espace and not this.espace_avant) { this.lacher() }
        this.espace_avant = espace
        if (this.attente > 2 and this.lachees < 12) {
            this.attente = 0
            this.lacher()
        }
    }
}
