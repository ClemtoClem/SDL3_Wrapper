# ── Accueil : le sommaire des scènes de démonstration ────────────────────────

const DEMOS = [
    {scene: "Formes et matériaux", texte: "Primitives et familles de matériaux"},
    {scene: "Physique", texte: "Chutes, rebonds et empilements"},
    {scene: "Hiérarchie", texte: "Un robot articulé : chaque pièce suit son parent"},
    {scene: "Lumières", texte: "Lumières colorées en mouvement"},
    {scene: "Terrain procédural", texte: "gen.terrain : bruits, érosion et biomes"},
    {scene: "Jeu 2D", texte: "Scène purement 2D : nœuds, calque d'interface, draw2d"},
]

# Une pièce du décor qui tourne sur elle-même : une Behaviour posée à la main
# sur un nœud existant de la scène (`super.init("Nom")`).
class Toupie extends Behaviour {
    let vitesse = [0, 0, 0]

    fn init(nom, vitesse) {
        super.init(nom)
        this.vitesse = vitesse
    }

    fn on_update(dt) {
        let r = this.rotation()
        this.set_rotation(r[0] + this.vitesse[0] * dt, r[1] + this.vitesse[1] * dt, r[2] + this.vitesse[2] * dt)
    }
}

class Accueil extends Scene {
    let temps = 0

    fn on_start() {
        # Menu : souris libre, même en plein écran, pour cliquer les boutons.
        input.set_mouse_mode("free")
        Toupie("Anneau", [20, 35, 0])
        Toupie("Noyau", [0, -50, 15])

        let panneau = ui.column({anchor: "center", gap: 10, pad: 24, bg: "#10141cdd", radius: 12})
        ui.label("Démonstration de scènes", {parent: panneau, font_size: 28, bold: true, color: "#ffd873"})
        ui.label("Chaque scène montre une facette de l'éditeur ; « Retour » ramène ici.",
                 {parent: panneau, font_size: 13, color: "#c8d0dc"})
        ui.separator({parent: panneau})
        for (demo in DEMOS) {
            let ligne = ui.row({parent: panneau, gap: 12, align: "center"})
            ui.button(demo.scene, fn(b) { this.load(demo.scene) }, {parent: ligne, w: 190})
            ui.label(demo.texte, {parent: ligne, font_size: 12, color: "#9aa6b8"})
        }
        let etat = this.state()
        etat.visites = (etat.visites or 0) + 1
        if (etat.visites > 1) {
            ui.label(format("Retour n°{} à l'accueil", etat.visites - 1), {anchor: "bottom", offset: [0, -16],
                                                                          font_size: 12, color: "#c8d0dc90"})
        }
    }

    fn on_update(dt) {
        this.temps += dt
        # Le noyau flotte : sa rotation est gérée par sa Toupie, sa hauteur ici.
        object.set_position("Noyau", 0, 2.4 + math.sin(this.temps * 1.6) * 0.3, 0)
    }
}
