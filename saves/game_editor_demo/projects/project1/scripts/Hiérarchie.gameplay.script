# ── Hiérarchie : on n'anime que quelques articulations, tout le reste suit ───
const demo = import "demo"

class Hierarchie extends demo.SceneDemo {
    fn on_start() {
        this.afficher_titre("Hiérarchie",
                            "Tourner « Robot » emporte tout ; plier une épaule emporte l'avant-bras et la main.", 400)
    }

    fn on_update(dt) {
        super.on_update(dt)
        let t = this.temps
        object.set_rotation("Robot", 0, math.sin(t * 0.4) * 40, 0)
        object.set_rotation("Épaule gauche", math.sin(t * 2.2) * 50, 0, 0)
        object.set_rotation("Épaule droite", -math.sin(t * 2.2) * 50, 0, 0)
        object.set_rotation("Coude gauche", -30 - math.sin(t * 3) * 25, 0, 0)
        object.set_rotation("Hanche gauche", -math.sin(t * 2.2) * 25, 0, 0)
        object.set_rotation("Hanche droite", math.sin(t * 2.2) * 25, 0, 0)
        object.set_rotation("Tête", 0, math.sin(t * 1.3) * 30, 0)
        object.set_rotation("Antenne", 0, t * 180, 0)
    }
}
