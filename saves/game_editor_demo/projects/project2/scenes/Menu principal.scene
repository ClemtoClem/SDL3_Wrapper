{
  "name": "Menu principal",
  "description": "Garage d'exposition : choix du circuit",
  "gameplay_script": "# ── Menu principal : choix du circuit et du nombre de tours ──────────────────\n\n# Circuits fermés (tours, rivaux, décor préparé par « Chargement ») puis\n# sprints (une ligne droite chronométrée, seul contre la montre).\nconst CIRCUITS = [\n    {nom: \"Circuit Ovale\", texte: \"Un anneau rapide, idéal pour débuter\"},\n    {nom: \"Circuit du Stade\", texte: \"Deux longues lignes droites, deux épingles\"},\n]\nconst SPRINTS = [\n    {nom: \"Circuit 1 - Metropolis Apex\", texte: \"Avenue, pavés et bornes mobiles\"},\n    {nom: \"Circuit 2 - Sylvan Trail\", texte: \"Terre battue et tronc suspendu\"},\n    {nom: \"Circuit 3 - Alpine Pass\", texte: \"La montée du col\"},\n    {nom: \"Circuit 4 - Coastline Dunes\", texte: \"Sable et booster de plage\"},\n    {nom: \"Circuit 5 - Industrial Docks\", texte: \"Les quais sous le conteneur\"},\n]\n\n# Un plateau d'exposition : la voiture posée dessus tourne avec lui.\nclass Plateau extends Behaviour {\n    let vitesse = 0\n    let angle = 0\n\n    fn init(nom, vitesse, angle) {\n        super.init(nom)\n        this.vitesse = vitesse\n        this.angle = angle\n    }\n\n    fn on_update(dt) {\n        this.angle += this.vitesse * dt\n        this.set_rotation(0, this.angle, 0)\n    }\n}\n\nclass MenuPrincipal extends Scene {\n    let tours = 3\n    let boutons_tours = []\n\n    fn choisir_tours(n) {\n        this.tours = n\n        for (b in this.boutons_tours) {\n            if (b.text == str(n)) { b.set_bg(\"#d49a2a\") } else { b.set_bg(\"#2a3240\") }\n        }\n    }\n\n    fn demarrer(circuit) {\n        let etat = this.state()\n        etat.circuit = circuit\n        etat.tours = this.tours\n        editor.log(format(\"Course : {} en {} tours\", circuit, this.tours))\n        this.load(\"Chargement\")\n    }\n\n    # Une entrée de liste : bouton du circuit et, s'il existe, son record.\n    fn entree(panneau, c, etat) {\n        let ligne = ui.column({parent: panneau, gap: 2})\n        ui.button(c.nom, fn(b) { this.demarrer(c.nom) }, {parent: ligne, w: 300, name: c.nom})\n        let record = etat[\"record_\" .. c.nom]\n        let detail = c.texte\n        if (record) { detail = format(\"{} — record : {} s\", c.texte, math.round(record * 100) / 100) }\n        ui.label(detail, {parent: ligne, font_size: 12, color: \"#9aa6b8\"})\n    }\n\n    fn on_start() {\n        # Menu : souris libre, même en plein écran, pour cliquer les boutons.\n        input.set_mouse_mode(\"free\")\n        Plateau(\"Plateau central\", 25, 0)\n        Plateau(\"Plateau gauche\", -18, 0)\n        Plateau(\"Plateau droit\", 18, 60)\n\n        let etat = this.state()\n        this.tours = etat.tours or 3\n        ui.label(\"TURBO SCRIPT\", {anchor: \"top_right\", offset: [-40, 30], font_size: 56, bold: true, color: \"#ffd873\"})\n        ui.label(\"Championnat procédural\", {anchor: \"top_right\", offset: [-44, 98], font_size: 18, color: \"#dfe6f0\"})\n\n        let panneau = ui.column({anchor: \"bottom_left\", offset: [40, -40], gap: 8, pad: 22, bg: \"#0c1016d8\", radius: 12,\n                                 w: 380})\n        ui.label(\"Circuits\", {parent: panneau, font_size: 20, bold: true})\n        for (c in CIRCUITS) { this.entree(panneau, c, etat) }\n        let ligne_tours = ui.row({parent: panneau, gap: 8, align: \"center\"})\n        ui.label(\"Tours :\", {parent: ligne_tours})\n        for (n in [1, 3, 5]) {\n            this.boutons_tours.append(ui.button(str(n), fn(b) { this.choisir_tours(n) }, {parent: ligne_tours, w: 48}))\n        }\n        this.choisir_tours(this.tours)\n        ui.separator({parent: panneau})\n        ui.label(\"Sprints\", {parent: panneau, font_size: 20, bold: true})\n        for (c in SPRINTS) { this.entree(panneau, c, etat) }\n        ui.separator({parent: panneau})\n        ui.button(\"Quitter\", fn(b) { this.quit() }, {parent: panneau, w: 300})\n        ui.label(\"Entrée : premier circuit\", {anchor: \"bottom_right\", offset: [-20, -16], font_size: 12,\n                                              color: \"#c8d0dca0\"})\n    }\n\n    fn on_update(dt) {\n        if (input.key(\"enter\")) { this.demarrer(CIRCUITS[0].nom) }\n    }\n}\n",
