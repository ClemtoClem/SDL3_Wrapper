# ── course : la logique commune des circuits fermés ──────────────────────────
#
# Un MODULE de la bibliothèque, importé par les scènes de circuit :
#
#     const course = import "course"
#     class CircuitOvale extends course.Course {}
#
# La scène fournit :
#   - la voiture du joueur « Voiture » (taggée camera_target),
#   - les rivaux, taggés « rival »,
#   - les points de passage, taggés « checkpoint » (dans l'ordre du tracé).
# game.state() apporte le nombre de tours et le décor préparé par la scène
# « Chargement » (sinon, valeurs par défaut : la scène se joue seule aussi).

const JOUEUR = "Voiture"
const VITESSE_MAX = 27
const ACCELERATION = 14
const FREINAGE = 24
const TRAINEE = 3.5
const BRAQUAGE = 2.1

fn replier(a) {
    while (a > math.pi) { a -= 2 * math.pi }
    while (a < -math.pi) { a += 2 * math.pi }
    return a
}

# ── Les voitures : des nœuds de la scène, pilotés par leur Behaviour ─────────

class Bolide extends Behaviour, PhysicsBody {
    let ia = false
    let adresse = 1          # fraction de la vitesse maximale
    let decalage = 0         # les rivaux visent un peu à côté : moins d'accrochages
    let cap = 0
    let vitesse = 0
    let suivant = 1
    let tour = 0
    let chrono_tour = 0
    let meilleur = 0
    let fini = false
    let temps_final = 0

    fn init(nom, ia, adresse, decalage) {
        super.init(nom)
        this.ia = ia
        this.adresse = adresse
        this.decalage = decalage
    }

    fn arreter() { this.set_velocity(0, 0, 0) }

    # Volant du pilote automatique : viser le prochain point, décalé
    # latéralement (perpendiculaire au cap).
    fn pilote_auto(points) {
        let p = this.position()
        let c = object.position(points[this.suivant])
        if (not p or not c) { return 0 }
        let dx = c[0] + math.cos(this.cap) * this.decalage - p[0]
        let dz = c[2] - math.sin(this.cap) * this.decalage - p[2]
        return math.clamp(replier(math.atan2(dx, dz) - this.cap) * 1.9, -1, 1)
    }

    fn conduire(gaz, volant, dt) {
        if (this.fini) { gaz = 0.2 }
        if (gaz > 0) {
            this.vitesse += ACCELERATION * gaz * dt
        } else if (gaz < 0) {
            this.vitesse += FREINAGE * gaz * dt
        }
        this.vitesse -= TRAINEE * dt
        this.vitesse = math.clamp(this.vitesse, -6, VITESSE_MAX * this.adresse)
        let adherence = math.clamp(math.abs(this.vitesse) / 8, 0, 1)
        this.cap = replier(this.cap + volant * BRAQUAGE * adherence * dt * math.sign(this.vitesse))
        let actuelle = this.velocity()
        let vy = 0
        if (actuelle) { vy = actuelle[1] }
        this.set_velocity(math.sin(this.cap) * this.vitesse, vy, math.cos(this.cap) * this.vitesse)
        this.set_rotation(0, math.deg(this.cap), 0)
    }

    # Avance d'un point de passage ; rend vrai à l'image où la voiture finit.
    fn progresser(points, tours, temps, dt) {
        this.chrono_tour += dt
        if (this.fini or object.distance(this.node(), points[this.suivant]) >= 7) { return false }
        this.suivant += 1
        if (this.suivant >= len(points)) { this.suivant = 0 }
        # Le point 0 est la ligne : l'atteindre boucle un tour.
        if (this.suivant != 1) { return false }
        this.tour += 1
        if (this.meilleur == 0 or this.chrono_tour < this.meilleur) { this.meilleur = this.chrono_tour }
        this.chrono_tour = 0
        if (this.tour < tours) { return false }
        this.fini = true
        this.temps_final = temps
        return true
    }

    # Plus c'est grand, plus la voiture est devant.
    fn avance(points, arrivees) {
        if (this.fini) { return 1000000 - arrivees.index_of(this) }   # arrivé plus tôt = devant
        let reste = object.distance(this.node(), points[this.suivant]) or 0
        let indice = this.suivant
        if (indice == 0) { indice = len(points) }
        return this.tour * 1000 + indice * 10 - reste / 100
    }
}

# ── Le décor : des objets créés par la scène, partis avec elle ───────────────

class Arbre extends Node3D {
    fn init(numero, x, z, teinte) {
        super.init("Arbre " .. numero, {pos: [x, 0, z]})
        scene.spawn({name: "Tronc " .. numero, parent: this.path(), shape: "cylinder", size: [0.5, 2.2, 0.5],
                     pos: [0, 1.1, 0], color: [96, 66, 42], material: "wood"})
        scene.spawn({name: "Feuillage " .. numero, parent: this.path(), shape: "cone", size: [2.6, 3.6, 2.6],
                     pos: [0, 3.8, 0], color: teinte, material: "pbr", roughness: 0.8})
    }
}

class Rocher extends Mesh3D {
    fn init(numero, x, z) {
        super.init("Rocher " .. numero, {shape: "icosahedron", size: [2.4, 1.8, 2.4], pos: [x, 0.4, z],
                                         color: [120, 116, 110], material: "pbr", roughness: 0.9})
    }
}

# ── La course ────────────────────────────────────────────────────────────────

abstract class Course extends Scene {
    let points = []
    let voitures = []
    let decor = []
    let tours = 3
    let phase = "départ"       # départ | course | arrivée
    let chrono_depart = 3.9
    let temps = 0
    let manuel = false
    let arrivees = []
    let hud = {}

    fn on_start() {
        let etat = this.state()
        this.tours = etat.tours or 3
        this.points = scene.find_tag("checkpoint")
        let noms = [JOUEUR]
        for (r in scene.find_tag("rival")) { noms.append(r) }
        let adresses = [1, 0.93, 0.87]
        let cap = this.cap_initial()
        for (i in range(len(noms))) {
            let v = Bolide(noms[i], i > 0, adresses[i], (i - 1) * 1.6)
            v.cap = cap
            this.voitures.append(v)
        }
        camera.follow(11, 4.8)
        this.planter_decor()
        this.construire_hud()
        editor.log(format("{} : {} tours, {} points de passage, {} voitures", this.scene_name, this.tours,
                          len(this.points), len(this.voitures)))
    }

    fn cap_initial() {
        let a = object.position(this.points[0])
        let b = object.position(this.points[1])
        if (not a or not b) { return 0 }
        return math.atan2(b[0] - a[0], b[2] - a[2])
    }

    fn planter_decor() {
        let etat = this.state()
        let places = etat.decor
        if (etat.decor_pour != this.scene_name or not places) {
            # Scène lancée seule : un petit décor calculé ici.
            places = []
            let rng = math.random_engine(7)
            for (i in range(24)) {
                let angle = rng.float(0, 2 * math.pi)
                places.append([math.cos(angle) * rng.float(60, 75), math.sin(angle) * rng.float(60, 75), rng.int(0, 2)])
            }
        }
        let n = 0
        for (d in places) {
            n += 1
            if (d[2] == 2) {
                this.decor.append(Rocher(n, d[0], d[1]))
            } else {
                let teinte = [46, 110, 52]
                if (d[2] == 1) { teinte = [70, 132, 58] }
                this.decor.append(Arbre(n, d[0], d[1], teinte))
            }
        }
    }

    fn construire_hud() {
        let haut = ui.row({anchor: "top", offset: [0, 12], gap: 18, pad: [18, 8], bg: "#0c1016c8", radius: 8})
        this.hud.tour = ui.label("Tour 0 / " .. this.tours, {parent: haut, font_size: 18, bold: true, color: "#ffffff"})
        this.hud.place = ui.label("1er / 3", {parent: haut, font_size: 18, bold: true, color: "#ffd873"})
        this.hud.temps = ui.label("0.00 s", {parent: haut, font_size: 18, color: "#c8d6e6"})
        this.hud.meilleur = ui.label("Meilleur tour : —", {parent: haut, font_size: 14, color: "#9aa6b8"})
        this.hud.vitesse = ui.label("0 km/h", {anchor: "bottom_right", offset: [-24, -20], font_size: 30, bold: true,
                                               color: "#ffffff"})
        this.hud.aide = ui.label("Pilote automatique — ZQSD / WASD / flèches pour prendre le volant",
                                 {anchor: "bottom_left", offset: [20, -20], font_size: 13, color: "#c8d0dcb0"})
        this.hud.depart = ui.label("3", {anchor: "center", font_size: 96, bold: true, color: "#ffd873"})
        ui.button("Menu", fn(b) { this.load("Menu principal") }, {anchor: "top_right", offset: [-14, 12], w: 80})
    }

    # Gaz et volant d'une voiture : le clavier pour le joueur (dès qu'il y
    # touche), le pilote automatique sinon.
    fn commandes(v) {
        if (v.ia) { return [1, v.pilote_auto(this.points)] }
        let g = input.axis("down", "up") + input.axis("s", "w")
        let d = input.axis("left", "right") + input.axis("a", "d") + input.axis("q", "e")
        if (g != 0 or d != 0) {
            if (not this.manuel) { this.hud.aide.text = "À vous de jouer !" }
            this.manuel = true
        }
        if (this.manuel) { return [g, d] }
        return [1, v.pilote_auto(this.points)]
    }

    fn place_joueur() {
        let moi = this.voitures[0]
        let place = 1
        for (v in this.voitures) {
            if (v != moi and v.avance(this.points, this.arrivees) > moi.avance(this.points, this.arrivees)) {
                place += 1
            }
        }
        return place
    }

    fn on_update(dt) {
        if (this.phase == "départ") {
            this.chrono_depart -= dt
            let n = math.ceil(this.chrono_depart - 0.9)
            if (n > 0) {
                this.hud.depart.text = str(n)
            } else {
                this.hud.depart.text = "GO !"
            }
            for (v in this.voitures) { v.arreter() }
            if (this.chrono_depart <= 0.9) {
                this.phase = "course"
                editor.status("Départ !")
            }
            return nil
        }
        this.temps += dt
        if (this.temps > 1.2) { this.hud.depart.hide() }
        for (v in this.voitures) {
            let c = this.commandes(v)
            v.conduire(c[0], c[1], dt)
            if (v.progresser(this.points, this.tours, this.temps, dt)) {
                this.arrivees.append(v)
                editor.log(format("{} arrive en {} ({} s)", v.node(), len(this.arrivees),
                                  math.round(this.temps * 100) / 100))
            }
        }
        let moi = this.voitures[0]
        let place = this.place_joueur()
        this.hud.tour.text = format("Tour {} / {}", math.min(moi.tour + 1, this.tours), this.tours)
        this.hud.place.text = format("{}e / {}", place, len(this.voitures))
        if (place == 1) { this.hud.place.text = format("1er / {}", len(this.voitures)) }
        let chrono = this.temps
        if (moi.fini) { chrono = moi.temps_final }   # figé à l'arrivée
        this.hud.temps.text = format("{} s", math.round(chrono * 100) / 100)
        if (moi.meilleur > 0) { this.hud.meilleur.text = format("Meilleur tour : {} s", math.round(moi.meilleur * 100) / 100) }
        this.hud.vitesse.text = format("{} km/h", i64(math.abs(moi.vitesse) * 3.6))
        if (this.phase == "course" and moi.fini) {
            this.phase = "arrivée"
            this.afficher_resultats()
        }
    }

    fn afficher_resultats() {
        let etat = this.state()
        let moi = this.voitures[0]
        let rang = this.arrivees.index_of(moi) + 1
        let panneau = ui.column({anchor: "center", gap: 10, pad: 26, bg: "#0c1016e6", radius: 12, align: "center"})
        let titre = "Victoire !"
        if (rang > 1) { titre = format("{}e place", rang) }
        ui.label(titre, {parent: panneau, font_size: 34, bold: true, color: "#ffd873"})
        ui.label(format("Temps : {} s", math.round(moi.temps_final * 100) / 100), {parent: panneau, font_size: 16})
        ui.label(format("Meilleur tour : {} s", math.round(moi.meilleur * 100) / 100),
                 {parent: panneau, font_size: 14, color: "#9aa6b8"})
        let clef = "record_" .. this.scene_name
        let record = etat[clef]
        if (not record or moi.temps_final < record) {
            etat[clef] = moi.temps_final
            ui.label("Nouveau record de la session !", {parent: panneau, color: "#7ee08a", bold: true})
        }
        let boutons = ui.row({parent: panneau, gap: 12})
        ui.button("Rejouer", fn(b) { this.load(this.scene_name) }, {parent: boutons, w: 140})
        ui.button("Menu principal", fn(b) { this.load("Menu principal") }, {parent: boutons, w: 160})
        editor.status(format("{} — {}", this.scene_name, titre))
    }
}
