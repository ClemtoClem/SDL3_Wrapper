# ── Course : compte à rebours, joueur contre deux rivaux, tours, classement ──
#
# Commun aux scènes de circuit. La scène fournit :
#   - la voiture du joueur « Voiture » (taggée camera_target),
#   - les rivaux, taggés « rival »,
#   - les points de passage, taggés « checkpoint » (dans l'ordre du tracé).
# game.state() apporte le nombre de tours et le décor préparé par la scène
# « Chargement » (sinon, valeurs par défaut : la scène se joue seule aussi).

const JOUEUR = "Voiture"
const VITESSE_MAX = 27
const ACCELERATION = 14
const FREINAGE = 24
const TRAINEE = 3.5
const BRAQUAGE = 2.1

let points = []
let voitures = []
let tours = 3
let phase = "départ"       # départ | course | arrivée
let chrono_depart = 3.9
let temps = 0
let manuel = false
let arrivees = []
let hud = {}

# ── Préparation ──────────────────────────────────────────────────────────────

fn voiture(nom, ia, adresse) {
    return {nom: nom, ia: ia, adresse: adresse, cap: 0, vitesse: 0, suivant: 1, tour: 0,
            chrono_tour: 0, meilleur: 0, fini: false, temps_final: 0, decalage: 0}
}

fn cap_vers(de, vers) {
    let a = object.position(de)
    let b = object.position(vers)
    if (not a or not b) { return 0 }
    return math.atan2(b[0] - a[0], b[2] - a[2])
}

fn replier(a) {
    while (a > math.pi) { a -= 2 * math.pi }
    while (a < -math.pi) { a += 2 * math.pi }
    return a
}

fn planter_decor() {
    let etat = game.state()
    let decor = etat.decor
    if (etat.decor_pour != game.scene() or not decor) {
        # Scène lancée seule : un petit décor calculé ici.
        decor = []
        let rng = math.random_engine(7)
        for (i in range(24)) {
            let angle = rng.float(0, 2 * math.pi)
            decor.append([math.cos(angle) * rng.float(60, 75), math.sin(angle) * rng.float(60, 75), rng.int(0, 2)])
        }
    }
    let n = 0
    for (d in decor) {
        n += 1
        if (d[2] == 2) {
            scene.spawn({name: "Rocher " .. n, shape: "icosahedron", size: [2.4, 1.8, 2.4], pos: [d[0], 0.4, d[1]],
                         color: [120, 116, 110], material: "pbr", roughness: 0.9})
        } else {
            scene.spawn({name: "Tronc " .. n, shape: "cylinder", size: [0.5, 2.2, 0.5], pos: [d[0], 1.1, d[1]],
                         color: [96, 66, 42], material: "wood"})
            let teinte = [46, 110, 52]
            if (d[2] == 1) { teinte = [70, 132, 58] }
            scene.spawn({name: "Feuillage " .. n, shape: "cone", size: [2.6, 3.6, 2.6], pos: [d[0], 3.8, d[1]],
                         color: teinte, material: "pbr", roughness: 0.8})
        }
    }
}

fn construire_hud() {
    let haut = ui.row({anchor: "top", offset: [0, 12], gap: 18, pad: [18, 8], bg: "#0c1016c8", radius: 8})
    hud.tour = ui.label("Tour 0 / " .. tours, {parent: haut, font_size: 18, bold: true, color: "#ffffff"})
    hud.place = ui.label("1er / 3", {parent: haut, font_size: 18, bold: true, color: "#ffd873"})
    hud.temps = ui.label("0.00 s", {parent: haut, font_size: 18, color: "#c8d6e6"})
    hud.meilleur = ui.label("Meilleur tour : —", {parent: haut, font_size: 14, color: "#9aa6b8"})
    hud.vitesse = ui.label("0 km/h", {anchor: "bottom_right", offset: [-24, -20], font_size: 30, bold: true, color: "#ffffff"})
    hud.aide = ui.label("Pilote automatique — ZQSD / WASD / flèches pour prendre le volant",
                        {anchor: "bottom_left", offset: [20, -20], font_size: 13, color: "#c8d0dcb0"})
    hud.depart = ui.label("3", {anchor: "center", font_size: 96, bold: true, color: "#ffd873"})
    ui.button("Menu", fn(b) { game.load_scene("Menu principal") }, {anchor: "top_right", offset: [-14, 12], w: 80})
}

fn on_start() {
    let etat = game.state()
    tours = etat.tours or 3
    points = scene.find_tag("checkpoint")
    let noms = [JOUEUR]
    for (r in scene.find_tag("rival")) { noms.append(r) }
    let adresses = [1, 0.93, 0.87]
    for (i in range(len(noms))) {
        let v = voiture(noms[i], i > 0, adresses[i])
        v.cap = cap_vers(points[0], points[1])
        v.decalage = (i - 1) * 1.6       # chaque rival vise un peu à côté : moins d'accrochages
        voitures.append(v)
    }
    camera.follow(11, 4.8)
    planter_decor()
    construire_hud()
    editor.log(format("{} : {} tours, {} points de passage, {} voitures", game.scene(), tours, len(points), len(voitures)))
}

# ── Conduite ─────────────────────────────────────────────────────────────────

fn pilote_auto(v) {
    let cible = points[v.suivant]
    let p = object.position(v.nom)
    let c = object.position(cible)
    if (not p or not c) { return 0 }
    # Viser un point décalé latéralement (perpendiculaire au cap).
    let dx = c[0] + math.cos(v.cap) * v.decalage - p[0]
    let dz = c[2] - math.sin(v.cap) * v.decalage - p[2]
    let ecart = replier(math.atan2(dx, dz) - v.cap)
    return math.clamp(ecart * 1.9, -1, 1)
}

fn conduire(v, dt) {
    let gaz = 1
    let volant = 0
    if (v.nom == JOUEUR) {
        let g = input.axis("down", "up") + input.axis("s", "w")
        let d = input.axis("left", "right") + input.axis("a", "d") + input.axis("q", "e")
        if (g != 0 or d != 0) {
            if (not manuel) { hud.aide.text = "À vous de jouer !" }
            manuel = true
        }
        if (manuel) {
            gaz = g
            volant = d
        } else {
            volant = pilote_auto(v)
        }
    } else {
        volant = pilote_auto(v)
    }
    if (v.fini) { gaz = 0.2 }
    if (gaz > 0) {
        v.vitesse += ACCELERATION * gaz * dt
    } else if (gaz < 0) {
        v.vitesse += FREINAGE * gaz * dt
    }
    v.vitesse -= TRAINEE * dt
    v.vitesse = math.clamp(v.vitesse, -6, VITESSE_MAX * v.adresse)
    let adherence = math.clamp(math.abs(v.vitesse) / 8, 0, 1)
    v.cap = replier(v.cap + volant * BRAQUAGE * adherence * dt * math.sign(v.vitesse))
    let actuelle = object.velocity(v.nom)
    let vy = 0
    if (actuelle) { vy = actuelle[1] }
    object.set_velocity(v.nom, math.sin(v.cap) * v.vitesse, vy, math.cos(v.cap) * v.vitesse)
    object.set_rotation(v.nom, 0, math.deg(v.cap), 0)
}

fn progression(v, dt) {
    v.chrono_tour += dt
    if (v.fini) { return nil }
    let cible = points[v.suivant]
    if (object.distance(v.nom, cible) < 7) {
        v.suivant += 1
        if (v.suivant >= len(points)) { v.suivant = 0 }
        # Le point 0 est la ligne : l'atteindre boucle un tour.
        if (v.suivant == 1) {
            v.tour += 1
            if (v.meilleur == 0 or v.chrono_tour < v.meilleur) { v.meilleur = v.chrono_tour }
            v.chrono_tour = 0
            if (v.tour >= tours) {
                v.fini = true
                v.temps_final = temps
                arrivees.append(v)
                editor.log(format("{} arrive en {} ({} s)", v.nom, len(arrivees), math.round(temps * 100) / 100))
            }
        }
    }
}

# Plus c'est grand, plus la voiture est devant.
fn avance(v) {
    if (v.fini) { return 1000000 - arrivees.index_of(v) }     # arrivé plus tôt = devant
    let reste = object.distance(v.nom, points[v.suivant]) or 0
    let indice = v.suivant
    if (indice == 0) { indice = len(points) }
    return v.tour * 1000 + indice * 10 - reste / 100
}

fn place_joueur() {
    let moi = voitures[0]
    let place = 1
    for (v in voitures) {
        if (v != moi and avance(v) > avance(moi)) { place += 1 }
    }
    return place
}

fn on_update(dt) {
    if (phase == "départ") {
        chrono_depart -= dt
        let n = math.ceil(chrono_depart - 0.9)
        if (n > 0) {
            hud.depart.text = str(n)
        } else {
            hud.depart.text = "GO !"
        }
        for (v in voitures) { object.set_velocity(v.nom, 0, 0, 0) }
        if (chrono_depart <= 0.9) {
            phase = "course"
            editor.status("Départ !")
        }
        return nil
    }
    temps += dt
    if (temps > 1.2) { hud.depart.hide() }
    for (v in voitures) {
        conduire(v, dt)
        progression(v, dt)
    }
    let moi = voitures[0]
    hud.tour.text = format("Tour {} / {}", math.min(moi.tour + 1, tours), tours)
    hud.place.text = format("{}e / {}", place_joueur(), len(voitures))
    if (place_joueur() == 1) { hud.place.text = format("1er / {}", len(voitures)) }
    let chrono = temps
    if (moi.fini) { chrono = moi.temps_final }   # figé à l'arrivée
    hud.temps.text = format("{} s", math.round(chrono * 100) / 100)
    if (moi.meilleur > 0) { hud.meilleur.text = format("Meilleur tour : {} s", math.round(moi.meilleur * 100) / 100) }
    hud.vitesse.text = format("{} km/h", i64(math.abs(moi.vitesse) * 3.6))
    if (phase == "course" and moi.fini) {
        phase = "arrivée"
        afficher_resultats()
    }
}

fn afficher_resultats() {
    let etat = game.state()
    let rang = arrivees.index_of(voitures[0]) + 1
    let panneau = ui.column({anchor: "center", gap: 10, pad: 26, bg: "#0c1016e6", radius: 12, align: "center"})
    let titre = "Victoire !"
    if (rang > 1) { titre = format("{}e place", rang) }
    ui.label(titre, {parent: panneau, font_size: 34, bold: true, color: "#ffd873"})
    ui.label(format("Temps : {} s", math.round(voitures[0].temps_final * 100) / 100), {parent: panneau, font_size: 16})
    ui.label(format("Meilleur tour : {} s", math.round(voitures[0].meilleur * 100) / 100), {parent: panneau, font_size: 14, color: "#9aa6b8"})
    let clef = "record_" .. game.scene()
    let record = etat[clef]
    if (not record or voitures[0].temps_final < record) {
        etat[clef] = voitures[0].temps_final
        ui.label("Nouveau record de la session !", {parent: panneau, color: "#7ee08a", bold: true})
    }
    let boutons = ui.row({parent: panneau, gap: 12})
    ui.button("Rejouer", fn(b) { game.load_scene(game.scene()) }, {parent: boutons, w: 140})
    ui.button("Menu principal", fn(b) { game.load_scene("Menu principal") }, {parent: boutons, w: 160})
    editor.status(format("{} — {}", game.scene(), titre))
}
