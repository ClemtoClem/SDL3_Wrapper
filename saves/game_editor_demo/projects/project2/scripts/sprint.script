# ── sprint : la logique commune des circuits en ligne (départ → arrivée) ─────
#
# Un MODULE de la bibliothèque, importé par les scènes de sprint :
#
#     const sprint = import "sprint"
#     class MetropolisApex extends sprint.Sprint {}
#
# La scène ne fournit que son décor ; tout le reste se déduit des étiquettes
# et des propriétés posées dans l'éditeur :
#   - tronçons de route : étiquettes road_asphalt, road_dirt, road_cobblestone,
#     road_parking (l'adhérence en dépend) ; le plus long est l'axe de la
#     course, parcouru de son extrémité −z à son extrémité +z ;
#   - boosters : étiquette « booster » ;
#   - obstacles animés : propriété obstacle_mode (piston | rotate | pingpong),
#     avec speed et amplitude facultatives.
# La voiture du joueur est créée par la scène (et détruite avec elle).

const VITESSE_MAX = 30
const ACCELERATION = 15
const FREINAGE = 26
const TRAINEE = 3.5
const BRAQUAGE = 2.2
const ADHERENCE = {road_asphalt: 1.0, road_parking: 0.9, road_cobblestone: 0.82, road_dirt: 0.72}

fn replier(a) {
    while (a > math.pi) { a -= 2 * math.pi }
    while (a < -math.pi) { a += 2 * math.pi }
    return a
}

# ── Le décor posé dans l'éditeur, équipé par la scène ────────────────────────

# Un tronçon de route existant : sait dire si un point est dessus.
class Troncon extends Behaviour {
    let adherence = 1

    fn init(nom, adherence) {
        super.init(nom)
        this.adherence = adherence
    }

    fn porte(p) {
        let q = this.to_local(p[0], p[1], p[2])
        let s = this.size()
        return math.abs(q[0]) <= s[0] / 2 + 0.5 and math.abs(q[2]) <= s[2] / 2 + 0.5 and q[1] > -1 and q[1] < 3
    }
}

# Une plaque d'accélération : relance la voiture qui passe dessus.
class Booster extends Behaviour {
    let repos = 0

    fn on_update(dt) { this.repos = math.max(0, this.repos - dt) }

    fn touche(p) {
        if (this.repos > 0) { return false }
        let q = this.to_local(p[0], p[1], p[2])
        let s = this.size()
        if (math.abs(q[0]) > s[0] / 2 + 1 or math.abs(q[2]) > s[2] / 2 + 1 or q[1] < -1 or q[1] > 3) { return false }
        this.repos = 1
        return true
    }
}

# Un obstacle animé selon ses propriétés (corps cinématique : la physique
# le suit, les voitures le heurtent).
class Obstacle extends Behaviour {
    let mode = "pingpong"
    let vitesse = 2
    let amplitude = 5
    let origine = nil
    let temps = 0

    fn init(nom) {
        super.init(nom)
        this.mode = this.prop("obstacle_mode") or "pingpong"
        this.vitesse = this.prop("speed") or 2
        this.amplitude = this.prop("amplitude") or (this.mode == "piston" and 2 or 30)
        this.origine = this.position()
    }

    fn on_update(dt) {
        this.temps += dt
        let o = this.origine
        if (this.mode == "piston") {
            this.set_position(o[0], o[1] + math.sin(this.temps * this.vitesse) * this.amplitude, o[2])
        } else if (this.mode == "rotate") {
            this.set_rotation(0, this.temps * this.vitesse * 50 % 360, 0)
        } else {
            this.set_rotation(0, 0, math.sin(this.temps * this.vitesse) * this.amplitude)
        }
    }
}

# ── La voiture du joueur : créée par la scène ────────────────────────────────

class Bolide extends Mesh3D, PhysicsBody {
    let cap = 0
    let vitesse = 0

    fn init(position, cap) {
        super.init("Voiture", {
            shape: "box", size: [1.9, 0.9, 3.8], pos: position, rot: [0, math.deg(cap), 0], tag: "camera_target",
            color: [242, 92, 62], material: "pbr", metallic: 0.25, roughness: 0.35,
            body: "dynamic", mass: 900, restitution: 0.05, friction: 0.05
        })
        this.cap = cap
        let moi = this.path()
        scene.spawn({name: "Habitacle", parent: moi, size: [1.5, 0.6, 1.6], pos: [0, 0.75, -0.3],
                     color: [60, 66, 86], material: "pbr", roughness: 0.3})
        let n = 0
        for (x in [-0.95, 0.95]) {
            for (z in [-1.2, 1.2]) {
                n += 1
                scene.spawn({name: "Roue " .. n, parent: moi, shape: "cylinder", size: [0.8, 0.3, 0.8],
                             pos: [x, -0.35, z], rot: [0, 0, 90], color: [24, 24, 28], material: "pbr", roughness: 0.9})
            }
        }
    }

    # `pente` : montée (positive) de la route par mètre parcouru dans le cap.
    fn conduire(gaz, volant, adherence, pente, dt) {
        if (gaz > 0) {
            this.vitesse += ACCELERATION * gaz * adherence * dt
        } else if (gaz < 0) {
            this.vitesse += FREINAGE * gaz * dt
        }
        this.vitesse -= TRAINEE * dt
        this.vitesse = math.clamp(this.vitesse, -6, VITESSE_MAX * adherence)
        let tenue = math.clamp(math.abs(this.vitesse) / 8, 0, 1) * adherence
        this.cap = replier(this.cap + volant * BRAQUAGE * tenue * dt * math.sign(this.vitesse))
        let actuelle = this.velocity()
        let vy = 0
        if (actuelle) { vy = actuelle[1] }
        vy = math.max(vy, this.vitesse * pente)
        this.set_velocity(math.sin(this.cap) * this.vitesse, vy, math.cos(this.cap) * this.vitesse)
        this.set_rotation(0, math.deg(this.cap), 0)
    }

    fn relancer() { this.vitesse = math.min(this.vitesse * 1.6 + 6, VITESSE_MAX * 1.5) }

    fn replacer(position, cap) {
        this.set_position(position[0], position[1], position[2])
        this.set_velocity(0, 0, 0)
        this.vitesse = 0
        this.cap = cap
    }
}

# ── La course ────────────────────────────────────────────────────────────────

abstract class Sprint extends Scene {
    let troncons = []
    let axe = nil              # le tronçon le plus long : la course le parcourt
    let boosters = []
    let obstacles = []
    let voiture = nil
    let depart_z = 0           # abscisses le long de l'axe (repère local du tronçon)
    let arrivee_z = 0
    let phase = "départ"       # départ | course | arrivée
    let chrono_depart = 3.9
    let temps = 0
    let manuel = false
    let hud = {}

    fn on_start() {
        for (tag in keys(ADHERENCE)) {
            for (nom in scene.find_tag(tag)) { this.troncons.append(Troncon(nom, ADHERENCE[tag])) }
        }
        if (len(this.troncons) == 0) {
            editor.warn(this.scene_name .. " : aucun tronçon de route (étiquette road_*)")
            return nil
        }
        this.axe = this.troncons[0]
        for (t in this.troncons) {
            if (t.size()[2] > this.axe.size()[2]) { this.axe = t }
        }
        for (nom in scene.find_tag("booster")) { this.boosters.append(Booster(nom)) }
        for (nom in scene.names()) {
            if (node.prop(nom, "obstacle_mode") != nil) { this.obstacles.append(Obstacle(nom)) }
        }
        let longueur = this.axe.size()[2]
        this.depart_z = -longueur / 2 + 8
        this.arrivee_z = longueur / 2 - 8
        let f = this.axe.forward()
        this.voiture = Bolide(this.point_axe(0, this.depart_z, 1.6), math.atan2(f[0], f[2]))
        camera.follow(11, 4.8)
        this.construire_hud()
        editor.log(format("{} : {} m, {} tronçons, {} boosters, {} obstacles", this.scene_name,
                          i64(this.arrivee_z - this.depart_z), len(this.troncons), len(this.boosters),
                          len(this.obstacles)))
    }

    # Point du repère de l'axe (x latéral, z le long de la course, h au-dessus).
    fn point_axe(x, z, h) {
        let s = this.axe.size()
        return this.axe.to_world(x, s[1] / 2 + h, z)
    }

    fn construire_hud() {
        let haut = ui.row({anchor: "top", offset: [0, 12], gap: 18, pad: [18, 8], bg: "#0c1016c8", radius: 8})
        this.hud.titre = ui.label(this.scene_name, {parent: haut, font_size: 18, bold: true, color: "#ffffff"})
        this.hud.reste = ui.label("— m", {parent: haut, font_size: 18, bold: true, color: "#ffd873"})
        this.hud.temps = ui.label("0.00 s", {parent: haut, font_size: 18, color: "#c8d6e6"})
        this.hud.surface = ui.label("", {parent: haut, font_size: 14, color: "#9aa6b8"})
        this.hud.vitesse = ui.label("0 km/h", {anchor: "bottom_right", offset: [-24, -20], font_size: 30, bold: true,
                                               color: "#ffffff"})
        this.hud.aide = ui.label("Pilote automatique — ZQSD / WASD / flèches pour prendre le volant",
                                 {anchor: "bottom_left", offset: [20, -20], font_size: 13, color: "#c8d0dcb0"})
        this.hud.depart = ui.label("3", {anchor: "center", font_size: 96, bold: true, color: "#ffd873"})
        ui.button("Menu", fn(b) { this.load("Menu principal") }, {anchor: "top_right", offset: [-14, 12], w: 80})
    }

    # Le tronçon sous la voiture (nil hors piste).
    fn sous(p) {
        for (t in this.troncons) {
            if (t.porte(p)) { return t }
        }
        return nil
    }

    # Pilote automatique : viser l'axe 18 m plus loin, en s'écartant d'un
    # obstacle posé sur la trajectoire.
    fn pilote_auto(q) {
        let lateral = 0
        let demi = this.axe.size()[0] / 2 - 1.5
        for (o in this.obstacles) {
            let p = o.world_position()
            let r = this.axe.to_local(p[0], p[1], p[2])
            if (math.abs(r[0]) < 3 and r[2] - q[2] > -2 and r[2] - q[2] < 28) {
                lateral = math.clamp(r[0] >= 0 and -4 or 4, -demi, demi)
            }
        }
        let cible = this.point_axe(lateral, q[2] + 18, 0)
        let p = this.voiture.position()
        let ecart = replier(math.atan2(cible[0] - p[0], cible[2] - p[2]) - this.voiture.cap)
        return math.clamp(ecart * 1.9, -1, 1)
    }

    fn on_update(dt) {
        if (this.voiture == nil) { return nil }
        if (this.phase == "départ") {
            this.chrono_depart -= dt
            let n = math.ceil(this.chrono_depart - 0.9)
            this.hud.depart.text = n > 0 and str(n) or "GO !"
            this.voiture.set_velocity(0, this.voiture.velocity()[1], 0)
            if (this.chrono_depart <= 0.9) {
                this.phase = "course"
                editor.status("Départ !")
            }
            return nil
        }
        if (this.phase == "course") { this.temps += dt }
        if (this.temps > 1.2) { this.hud.depart.hide() }

        let p = this.voiture.world_position()
        let q = this.axe.to_local(p[0], p[1], p[2])
        let troncon = this.sous(p)

        let gaz = 1
        let volant = 0
        let g = input.axis("down", "up") + input.axis("s", "w")
        let d = input.axis("left", "right") + input.axis("a", "d") + input.axis("q", "e")
        if (g != 0 or d != 0) {
            if (not this.manuel) { this.hud.aide.text = "À vous de jouer !" }
            this.manuel = true
        }
        if (this.manuel) {
            gaz = g
            volant = d
        } else {
            volant = this.pilote_auto(q)
        }
        if (this.phase == "arrivée") { gaz = 0 }

        let adherence = 0.6
        let pente = 0
        if (troncon) {
            adherence = troncon.adherence
            let f = troncon.forward()
            let sens = math.sign(math.sin(this.voiture.cap) * f[0] + math.cos(this.voiture.cap) * f[2])
            pente = f[1] / math.max(0.2, math.hypot(f[0], f[2])) * sens
            this.hud.surface.text = troncon.node()
        } else {
            this.hud.surface.text = "hors piste"
        }
        this.voiture.conduire(gaz, volant, adherence, pente, dt)
        for (b in this.boosters) {
            if (b.touche(p)) {
                this.voiture.relancer()
                editor.status("Booster !")
            }
        }

        # Sortie de piste : la voiture repart sur l'axe, un peu en arrière.
        if (q[1] < -12) {
            let z = math.max(this.depart_z, q[2] - 6)
            let f = this.axe.forward()
            this.voiture.replacer(this.point_axe(0, z, 1.6), math.atan2(f[0], f[2]))
            editor.status("Sortie de piste !")
        }

        this.hud.reste.text = format("{} m", i64(math.max(0, this.arrivee_z - q[2])))
        this.hud.temps.text = format("{} s", math.round(this.temps * 100) / 100)
        this.hud.vitesse.text = format("{} km/h", i64(math.abs(this.voiture.vitesse) * 3.6))
        if (this.phase == "course" and q[2] >= this.arrivee_z) {
            this.phase = "arrivée"
            this.afficher_resultats()
        }
    }

    fn afficher_resultats() {
        let etat = this.state()
        let panneau = ui.column({anchor: "center", gap: 10, pad: 26, bg: "#0c1016e6", radius: 12, align: "center"})
        ui.label("Arrivée !", {parent: panneau, font_size: 34, bold: true, color: "#ffd873"})
        ui.label(format("Temps : {} s", math.round(this.temps * 100) / 100), {parent: panneau, font_size: 16})
        let clef = "record_" .. this.scene_name
        if (not etat[clef] or this.temps < etat[clef]) {
            etat[clef] = this.temps
            ui.label("Nouveau record de la session !", {parent: panneau, color: "#7ee08a", bold: true})
        }
        let boutons = ui.row({parent: panneau, gap: 12})
        ui.button("Rejouer", fn(b) { this.load(this.scene_name) }, {parent: boutons, w: 140})
        ui.button("Menu principal", fn(b) { this.load("Menu principal") }, {parent: boutons, w: 160})
        editor.log(format("{} : arrivée en {} s", this.scene_name, math.round(this.temps * 100) / 100))
        editor.status(format("{} — arrivée en {} s", this.scene_name, math.round(this.temps * 100) / 100))
    }
}
