# ── Menu principal : choix du circuit et du nombre de tours ──────────────────

# Circuits fermés (tours, rivaux, décor préparé par « Chargement ») puis
# sprints (une ligne droite chronométrée, seul contre la montre).
const CIRCUITS = [
    {nom: "Circuit Ovale", texte: "Un anneau rapide, idéal pour débuter"},
    {nom: "Circuit du Stade", texte: "Deux longues lignes droites, deux épingles"},
]
const SPRINTS = [
    {nom: "Circuit 1 - Metropolis Apex", texte: "Avenue, pavés et bornes mobiles"},
    {nom: "Circuit 2 - Sylvan Trail", texte: "Terre battue et tronc suspendu"},
    {nom: "Circuit 3 - Alpine Pass", texte: "La montée du col"},
    {nom: "Circuit 4 - Coastline Dunes", texte: "Sable et booster de plage"},
    {nom: "Circuit 5 - Industrial Docks", texte: "Les quais sous le conteneur"},
]

# Un plateau d'exposition : la voiture posée dessus tourne avec lui.
class Plateau extends Behaviour {
    let vitesse = 0
    let angle = 0

    fn init(nom, vitesse, angle) {
        super.init(nom)
        this.vitesse = vitesse
        this.angle = angle
    }

    fn on_update(dt) {
        this.angle += this.vitesse * dt
        this.set_rotation(0, this.angle, 0)
    }
}

class MenuPrincipal extends Scene {
    let tours = 3
    let boutons_tours = []

    fn choisir_tours(n) {
        this.tours = n
        for (b in this.boutons_tours) {
            if (b.text == str(n)) { b.set_bg("#d49a2a") } else { b.set_bg("#2a3240") }
        }
    }

    fn demarrer(circuit) {
        let etat = this.state()
        etat.circuit = circuit
        etat.tours = this.tours
        editor.log(format("Course : {} en {} tours", circuit, this.tours))
        this.load("Chargement")
    }

    # Une entrée de liste : bouton du circuit et, s'il existe, son record.
    fn entree(panneau, c, etat) {
        let ligne = ui.column({parent: panneau, gap: 2})
        ui.button(c.nom, fn(b) { this.demarrer(c.nom) }, {parent: ligne, w: 300, name: c.nom})
        let record = etat["record_" .. c.nom]
        let detail = c.texte
        if (record) { detail = format("{} — record : {} s", c.texte, math.round(record * 100) / 100) }
        ui.label(detail, {parent: ligne, font_size: 12, color: "#9aa6b8"})
    }

    fn on_start() {
        # Menu : souris libre, même en plein écran, pour cliquer les boutons.
        input.set_mouse_mode("free")
        Plateau("Plateau central", 25, 0)
        Plateau("Plateau gauche", -18, 0)
        Plateau("Plateau droit", 18, 60)

        let etat = this.state()
        this.tours = etat.tours or 3
        ui.label("TURBO SCRIPT", {anchor: "top_right", offset: [-40, 30], font_size: 56, bold: true, color: "#ffd873"})
        ui.label("Championnat procédural", {anchor: "top_right", offset: [-44, 98], font_size: 18, color: "#dfe6f0"})

        let panneau = ui.column({anchor: "bottom_left", offset: [40, -40], gap: 8, pad: 22, bg: "#0c1016d8", radius: 12,
                                 w: 380})
        ui.label("Circuits", {parent: panneau, font_size: 20, bold: true})
        for (c in CIRCUITS) { this.entree(panneau, c, etat) }
        let ligne_tours = ui.row({parent: panneau, gap: 8, align: "center"})
        ui.label("Tours :", {parent: ligne_tours})
        for (n in [1, 3, 5]) {
            this.boutons_tours.append(ui.button(str(n), fn(b) { this.choisir_tours(n) }, {parent: ligne_tours, w: 48}))
        }
        this.choisir_tours(this.tours)
        ui.separator({parent: panneau})
        ui.label("Sprints", {parent: panneau, font_size: 20, bold: true})
        for (c in SPRINTS) { this.entree(panneau, c, etat) }
        ui.separator({parent: panneau})
        ui.button("Quitter", fn(b) { this.quit() }, {parent: panneau, w: 300})
        ui.label("Entrée : premier circuit", {anchor: "bottom_right", offset: [-20, -16], font_size: 12,
                                              color: "#c8d0dca0"})
    }

    fn on_update(dt) {
        if (input.key("enter")) { this.demarrer(CIRCUITS[0].nom) }
    }
}
