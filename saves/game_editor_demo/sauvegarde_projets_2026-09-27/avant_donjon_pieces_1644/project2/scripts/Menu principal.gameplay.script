# ── Menu principal : choix du circuit et du nombre de tours ──────────────────

const CIRCUITS = [
    {nom: "Circuit Ovale", texte: "Un anneau rapide, idéal pour débuter"},
    {nom: "Circuit du Stade", texte: "Deux longues lignes droites, deux épingles"},
]

let tours = 3
let boutons_tours = []
let temps = 0

fn choisir_tours(n) {
    tours = n
    for (b in boutons_tours) {
        if (b.text == str(n)) { b.set_bg("#d49a2a") } else { b.set_bg("#2a3240") }
    }
}

fn demarrer(circuit) {
    let etat = game.state()
    etat.circuit = circuit
    etat.tours = tours
    editor.log(format("Course : {} en {} tours", circuit, tours))
    game.load_scene("Chargement")
}

fn on_start() {
    let etat = game.state()
    tours = etat.tours or 3
    ui.label("TURBO SLED", {anchor: "top_right", offset: [-40, 30], font_size: 56, bold: true, color: "#ffd873"})
    ui.label("Championnat procédural", {anchor: "top_right", offset: [-44, 98], font_size: 18, color: "#dfe6f0"})

    let panneau = ui.column({anchor: "bottom_left", offset: [40, -40], gap: 10, pad: 22, bg: "#0c1016d8", radius: 12, w: 380})
    ui.label("Circuits", {parent: panneau, font_size: 20, bold: true})
    for (c in CIRCUITS) {
        let ligne = ui.column({parent: panneau, gap: 2})
        ui.button(c.nom, fn(b) { demarrer(c.nom) }, {parent: ligne, w: 300, name: c.nom})
        let record = etat["record_" .. c.nom]
        let detail = c.texte
        if (record) { detail = format("{} — record : {} s", c.texte, math.round(record * 100) / 100) }
        ui.label(detail, {parent: ligne, font_size: 12, color: "#9aa6b8"})
    }
    ui.separator({parent: panneau})
    let ligne_tours = ui.row({parent: panneau, gap: 8, align: "center"})
    ui.label("Tours :", {parent: ligne_tours})
    for (n in [1, 3, 5]) {
        boutons_tours.append(ui.button(str(n), fn(b) { choisir_tours(n) }, {parent: ligne_tours, w: 48}))
    }
    choisir_tours(tours)
    ui.separator({parent: panneau})
    ui.button("Quitter", fn(b) { game.quit() }, {parent: panneau, w: 300})
    ui.label("Entrée : premier circuit", {anchor: "bottom_right", offset: [-20, -16], font_size: 12, color: "#c8d0dca0"})
}

fn on_update(dt) {
    temps += dt
    # Les voitures exposées tournent sur leurs plateaux ; la caméra dérive.
    object.set_rotation("Plateau central", 0, temps * 25, 0)
    object.set_rotation("Plateau gauche", 0, -temps * 18, 0)
    object.set_rotation("Plateau droit", 0, temps * 18 + 60, 0)
    if (input.key("enter")) { demarrer(CIRCUITS[0].nom) }
}
