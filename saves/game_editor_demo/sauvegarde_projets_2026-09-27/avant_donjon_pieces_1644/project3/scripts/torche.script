# ── Torche : fait vaciller la lumière qui porte ce script ────────────────────
# Script de BIBLIOTHÈQUE, attaché à chaque lumière de torche : `self` est le
# nom du nœud (un interpréteur partagé par toutes les torches).

let base = {}

fn on_start(self) {
    base[self] = light.intensity(self) or 2.5
}

fn on_update(self, dt) {
    let t = game.time()
    let phase = gen.hash(len(self), 7) * 10
    let vacille = math.sin(t * 9 + phase) * 0.18 + math.sin(t * 23 + phase * 2) * 0.08
    light.set_intensity(self, base[self] * (1 + vacille))
}
