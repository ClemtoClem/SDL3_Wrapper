# Mod « extra » : un bonus quand on extrait un rubis avec une pioche en fer.
voxel.on("block_broken", fn(x, y, z, block, actor) {
    if (block == "extra:ruby_ore" and entity.held(actor) == "core:iron_pickaxe") {
        world.drop("ruby", 1, x + 0.5, y + 0.5, z + 0.5)
        game.say("Rubis supplémentaire !")
    }
    return true
})
voxel.command("rubies", "/rubies", "compte vos rubis", fn(sender, args) {
    return format("{} rubis", entity.count(sender, "extra:ruby"))
})
