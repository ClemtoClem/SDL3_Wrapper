# Commandes : boutons d'appel (palier), panneau de cabine (étages, portes,
# destinations), moteur (vérification + configuration), kits.

fn el_player_name(p) {
    let n = entity.prop(p, "name")
    if (n == nil) { return "joueur" }
    return n
}

fn el_may_configure(e, p) {
    if (not EL.settings.owner_only or e.owner == "" or e.owner == nil) { return true }
    return e.owner == el_player_name(p) or game.mode() == "creative"
}

# Indice de l'arrêt d'un bouton d'appel (le palier dont il fait partie).
fn el_floor_of_call(e, x, y, z) {
    let i = 0
    while (i < len(e.floors)) {
        for (c in e.floors[i].calls) {
            if (c.x == x and c.y == y and c.z == z) { return i }
        }
        i += 1
    }
    # Bouton posé ailleurs : l'arrêt le plus proche en hauteur.
    let best = 0
    let j = 0
    while (j < len(e.floors)) {
        if (el_abs(e.floors[j].y + 2 - y) < el_abs(e.floors[best].y + 2 - y)) { best = j }
        j += 1
    }
    return best
}

# Panneau de cabine : un bouton par étage, les destinations, portes.
fn el_open_panel(p, e) {
    let buttons = []
    let i = 0
    while (i < len(e.floors)) {
        let label = format("{} — {}", el_floor_label(e, i), el_floor_name(e, i))
        if (i == e.floor) { label = label + " (ici)" }
        buttons.push({id: format("floor:{}", i), label: label})
        i += 1
    }
    for (id in el_external_for(e)) {
        let d = el_dest(e, id)
        if (d != nil) { buttons.push({id: format("dest:{}", id), label: format("▶ {}", d.label)}) }
    }
    buttons.push({id: "open", label: "◀▶ Ouvrir"})
    buttons.push({id: "close", label: "▶◀ Fermer"})
    game.open_ui(p, "form", {id: format("elevators:panel:{}", e.id), title: "Ascenseur",
        description: format("Cabine à l'arrêt {} ({}).", el_floor_label(e, e.floor), el_floor_name(e, e.floor)),
        fields: [], buttons: buttons, submit: ""})
}

# Champs de configuration d'un ascenseur (tableau électrique) : noms et
# numéros des étages, portes, vitesse, destinations, maintenance.
fn el_config_fields(e) {
    let fields = []
    let i = 0
    while (i < len(e.floors)) {
        fields.push({id: format("name:{}", i), type: "text", label: format("Arrêt {} (y = {}) : nom", i, e.floors[i].y + 1),
                     default: e.floors[i].name})
        fields.push({id: format("label:{}", i), type: "text", label: "Numéro affiché (0 à 19, -- …)", default: el_floor_label(e, i)})
        i += 1
    }
    let speed = EL.settings.speed
    if (e.speed != nil) { speed = e.speed }
    fields.push({id: "door_time", type: "number", label: "Portes ouvertes (s)", default: el_door_time(e), min: 1, max: 30})
    fields.push({id: "speed", type: "number", label: "Vitesse (blocs/s)", default: speed, min: 0.5, max: 12})
    for (id in keys(el_destinations())) {
        fields.push({id: format("ext:{}", id), type: "bool", label: format("Destination : {}", el_dest_label(id)),
                     default: el_contains(e.external, id)})
    }
    fields.push({id: "maintenance", type: "bool", label: "En maintenance (hors service)", default: e.state == "maintenance"})
    return fields
}

# Applique les valeurs du formulaire ; rend un message.
fn el_apply_config(e, p, v) {
    if (not el_may_configure(e, p)) { return "refusé : seul son constructeur peut configurer cet ascenseur." }
    let i = 0
    while (i < len(e.floors)) {
        let name = v[format("name:{}", i)]
        if (name != nil) { e.floors[i].name = name }
        let label = v[format("label:{}", i)]
        if (label != nil and label != "") { e.floors[i].label = label }
        i += 1
    }
    let door = num(str(v["door_time"]))
    if (door != nil and door >= 1 and door <= 30) { e.door_time = door }
    let speed = num(str(v["speed"]))
    if (speed != nil and speed >= 0.5 and speed <= 12) { e.speed = speed }
    let ext = []
    for (id in keys(el_destinations())) {
        if (v[format("ext:{}", id)] == true) { ext.push(id) }
    }
    e.external = ext
    if (v["maintenance"] == true and e.state == "idle") { e.state = "maintenance" }
    if (v["maintenance"] != true and e.state == "maintenance") { e.state = "idle" }
    e.owner = el_player_name(p)
    el_refresh_displays(e)
    el_save()
    return "configuration enregistrée."
}

voxel.on("form_submit", fn(p, form, v) {
    if (not form.starts_with("elevators:") or form.starts_with("elevators:board:")) { return nil }
    let parts = form.split(":")
    let e = el_get(form.sub(len(parts[0]) + len(parts[1]) + 2))
    if (e == nil) { return nil }
    if (parts[1] == "panel") {
        let b = v._button
        if (b == nil) { return nil }
        el_sound("button", el_cabin_cells(e, e.floor).panel)
        if (b.starts_with("floor:")) {
            let i = 0
            while (i < len(e.floors)) {
                if (b == format("floor:{}", i)) { el_request(e, i) }
                i += 1
            }
        } else if (b.starts_with("dest:")) {
            el_request_external(e, b.sub(5))
        } else if (b == "open") {
            el_request(e, e.floor)
            e.hold = true
        } else if (b == "close") {
            if (e.state == "doors_open") { e.state_time = 1000 }
        }
        return nil
    }
})

voxel.on("block_use", fn(x, y, z, block, actor) {
    let held = entity.held(actor)
    if (held != nil and held.starts_with("elevators:") and held.contains("_kit")) {
        if (held.contains("cabin_kit")) { el_place_cabin_kit(actor, x, y, z, held) } else { el_place_landing_kit(actor, x, y, z, held) }
        return false
    }
    if (block == nil or not block.starts_with("elevators:")) { return true }
    if (block == "elevators:motor") {
        el_say("le moteur se commande depuis le tableau électrique de l'ascenseur (étage le plus bas, à droite de la porte palière).")
        return false
    }
    let e = el_find_at(x, y, z)
    if (e == nil) {
        if (el_is(block, "call") or el_is(block, "cabin_panel")) {
            el_say("cet ascenseur n'est pas en service : diagnostic et mise en service au tableau électrique.")
            return false
        }
        return true
    }
    if (el_is(block, "call")) {
        let i = el_floor_of_call(e, x, y, z)
        el_sound("button", el_pos(x, y, z))
        el_request(e, i)
        return false
    }
    if (el_is(block, "cabin_panel")) {
        el_open_panel(actor, e)
        return false
    }
    if (el_is(block, "landing_door") or el_is(block, "cabin_door")) {
        # Une porte palière ne s'ouvre qu'avec la cabine derrière elle.
        let i = el_floor_of_call(e, x, y + 1, z)
        if (i == e.floor and e.state == "idle") { el_request(e, i) } else { el_sound("lock", el_pos(x, y, z)) }
        return false
    }
    return true
})

# Afficheur ou panneau posé dans une cabine : pris en compte au pas suivant
# (l'événement précède la pose du bloc).
voxel.on("block_placed", fn(x, y, z, block, actor) {
    if (block == nil or not (el_is(block, "display") or el_is(block, "cabin_panel"))) { return true }
    let e = el_find_at(x, y, z)
    if (e != nil) { e.cabin_dirty = true }
    return true
})

# Un composant cassé : l'ascenseur est revérifié (et mis hors service s'il manque l'essentiel).
voxel.on("block_broken", fn(x, y, z, block, actor) {
    if (block == nil or not block.starts_with("elevators:")) { return nil }
    let e = el_find_at(x, y, z)
    if (e == nil) { return nil }
    if (el_is(block, "display") or el_is(block, "cabin_panel")) {
        e.cabin_dirty = true
        return nil
    }
    if (block == "elevators:motor") {
        EL.records[e.id] = nil
        el_save()
        el_say("moteur démonté : l'ascenseur est hors service.")
        return nil
    }
    if (e.state == "idle") {
        if (el_register(e.motor.x, e.motor.y, e.motor.z, true) == nil) {
            e.state = "failed"
            el_save()
            el_say("ascenseur en panne : un composant manque (diagnostic au tableau électrique).")
        }
    }
})

# Ascenseur d'exemple, bâti à côté du joueur : gaine de côté `size` (5, 7, 9),
# un palier tous les 5 blocs avec sa passerelle (côté ouest, vers le joueur),
# cabine au rez-de-chaussée, moteur. `mode` : "wide" (portes doubles 2 × 2),
# "multi" (une seconde porte côté est, desservie un étage sur deux) ; `h` :
# hauteur de la cabine (4 : 2 blocs libres, 5 : 3 blocs libres).
fn el_build_demo(p, style, n, size, mode, h) {
    let g = el_geom((size - 3) / 2)
    let half = g.half
    let wall = g.wall
    let q = entity.pos(p)
    let cx = math.floor(q.x) + wall + 3
    let cz = math.floor(q.z)
    let y0 = math.floor(q.y) - 1
    let gap = math.max(h + 1, EL.settings.floor_gap)
    let top = y0 + gap * (n - 1) + h + 1
    world.fill(cx - wall, y0 - 1, cz - wall, cx + wall, top, cz + wall, "elevators:shaft_wall")
    world.fill(cx - half, y0, cz - half, cx + half, top - 1, cz + half, "core:air")
    # Rails de guidage et câbles visibles dans la gaine (paroi nord).
    let y = y0
    while (y < top) {
        world.set(cx - 1, y, cz - wall, "elevators:rail")
        world.set(cx + 1, y, cz - wall, "elevators:rail")
        y += 1
    }
    world.set(cx, top, cz, "elevators:motor")
    let width = 1
    let u0 = 0
    if (mode == "wide" and half >= 2) {
        width = 2
        u0 = -1
    }
    let doors = [{side: "w", u: u0, width: width}]
    if (mode == "multi") { doors.push({side: "e", u: 0, width: 1}) }
    let i = 0
    while (i < n) {
        let fy = y0 + gap * i
        # Passerelle devant la porte ouest (et est, aux étages pairs en « multi »).
        world.fill(cx - wall - 4, fy, cz - wall + 1, cx - wall - 1, fy, cz + wall - 1, "core:stone")
        world.fill(cx - wall - 4, fy + 1, cz - wall + 1, cx - wall - 1, fy + h - 1, cz + wall - 1, "core:air")
        let a = el_face_cell(cx, cz, "w", wall, u0)
        el_place_landing_door(a.x, fy + 1, a.z, "w", style, width, i % 2 == 1)
        if (mode == "multi" and i % 2 == 0) {
            world.fill(cx + wall + 1, fy, cz - wall + 1, cx + wall + 4, fy, cz + wall - 1, "core:stone")
            world.fill(cx + wall + 1, fy + 1, cz - wall + 1, cx + wall + 4, fy + h - 1, cz + wall - 1, "core:air")
            let b = el_face_cell(cx, cz, "e", wall, 0)
            el_place_landing_cells(b.x, fy + 1, b.z, "e", style, false)
        }
        i += 1
    }
    el_build_cabin(el_pos(cx - half, y0, cz - half), style, half, h, doors)
    let e = el_register(cx, top, cz, false)
    if (e != nil) { el_place_switchboard(e) } # poste de commande, au rez-de-chaussée
    return e
}

let EL_USAGE = "usage : /elevator build [style] [étages] [5|7|9] [4|5] [wide|multi] | verify | list"

fn el_command(sender, args) {
    let what = "list"
    if (len(args) > 0) { what = args[0] }
    if (what == "build" or what == "demo") {
        let style = "modern"
        if (len(args) > 1) { style = args[1] }
        if (not el_contains(EL.STYLES, style)) { return format("style inconnu « {} » ({})", style, join(EL.STYLES, ", ")) }
        let n = 3
        if (len(args) > 2) {
            let k = num(args[2])
            if (k != nil and k >= 1) { n = k }
        }
        # Puis, dans l'ordre : côté de la gaine (5, 7, 9), hauteur de cabine
        # (4, 5) ; « h4 » / « h5 » et « wide » / « multi » à n'importe quelle place.
        let size = 7
        let h = EL.settings.cabin_height
        let mode = ""
        let numbers = 0
        let k = 3
        while (k < len(args)) {
            let a = args[k]
            let v = num(a)
            if (a == "wide" or a == "multi") {
                mode = a
            } else if (a == "h4" or a == "h5") {
                h = num(a.sub(1))
            } else if (v != nil and numbers == 0) {
                size = el_odd_size(v, 7)
                numbers = 1
            } else if (v != nil and numbers == 1) {
                if (v != 4 and v != 5) { return "hauteur de cabine : 4 (2 blocs libres) ou 5 (3 blocs libres)" }
                h = v
                numbers = 2
            } else {
                return format("argument inconnu « {} » — {}", a, EL_USAGE)
            }
            k += 1
        }
        if (size < EL.settings.shaft_min or size > EL.settings.shaft_max) {
            return format("gaine de {} × {} hors des réglages ({} à {})", size, size, EL.settings.shaft_min, EL.settings.shaft_max)
        }
        let e = el_build_demo(sender, style, n, size, mode, h)
        if (e == nil) { return "construction impossible ici" }
        return format("ascenseur {} : {} étages, gaine {} × {}, cabine de {} de haut ({} blocs libres), moteur en {}", style, n, size, size,
                      h, h - 2, e.id)
    }
    if (what == "list" or what == "liste") {
        let out = []
        for (id in keys(EL.records)) {
            let e = EL.records[id]
            out.push(format("{} ({}, gaine {} × {}, {} arrêts, {}, cabine à {})", id, e.style, 2 * e.half + 3, 2 * e.half + 3,
                            len(e.floors), e.state, el_floor_label(e, e.floor)))
        }
        if (len(out) == 0) { return "aucun ascenseur en service dans cette dimension" }
        return join(out, " ; ")
    }
    if (what == "verify" or what == "verifier") {
        let out = []
        for (id in keys(EL.records)) {
            let e = EL.records[id]
            let r = el_scan(e.motor.x, e.motor.y, e.motor.z)
            if (len(r.problems) == 0) { out.push(format("{} : en ordre", id)) } else { out.push(format("{} : {}", id, join(r.problems, " ; "))) }
        }
        if (len(out) == 0) { return "aucun ascenseur enregistré" }
        return join(out, "\n")
    }
    if (what == "help") {
        return "/elevator build [style] [floors] [size] [height] [mode]\n" +
               format("    style : {}\n", join(EL.STYLES, ", ")) +
               "    floors : >= 1 ; size : 5, 7 ou 9 (côté de la gaine)\n" +
               "    height : 4 (2 blocs libres) ou 5 (3 blocs libres), ou h4 / h5\n" +
               "    mode : wide (portes doubles), multi (deux faces)\n" +
               "/elevator verify\n" +
               "/elevator list"
    }
    return EL_USAGE
}

voxel.command("elevator", "/elevator build [style] [floors] [size] [height] [wide|multi] | verify | list", "ascenseurs", el_command)
voxel.command("ascenseur", "/ascenseur demo [style] [étages] [taille] [hauteur] | verifier | liste", "ascenseurs", el_command)
