# Générateur de terrain écrit en script : des îles flottantes.
# Choisir avec : voxelia --world=iles --generator=core:islands
voxel.generator("islands", fn(ox, oy, oz, seed) {
    if (oy < 48 or oy > 112) { return nil }
    for (lx in range(0, 16)) {
        for (lz in range(0, 16)) {
            let x = ox + lx
            let z = oz + lz
            let n = gen.noise(x, z, 0.015, seed)
            if (n > 0.25) {
                let top = 80 + math.floor(gen.noise(x, z, 0.05, seed + 3) * 6)
                let depth = math.floor((n - 0.25) * 40)
                for (y in range(top - depth, top + 1)) {
                    if (y >= oy and y < oy + 16) {
                        let block = "core:stone"
                        if (y == top) { block = "core:grass" } else { if (y > top - 3) { block = "core:dirt" } }
                        gen.set(x, y, z, block)
                    }
                }
                if (top + 1 >= oy and top + 1 < oy + 16 and gen.random(x, top, z) < 0.01) {
                    gen.set(x, top + 1, z, "core:flower_red")
                }
            }
        }
    }
})
