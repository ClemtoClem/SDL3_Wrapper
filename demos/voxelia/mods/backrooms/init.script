# Mod « backrooms » : ambiance sonore de chaque niveau et messages.
# La dimension (world.json) reçoit les joueurs morts de suffocation
# (« enterOnDeath ») ; chaque niveau est une dimension, reliée aux suivantes
# par un ascenseur (mod « elevators ») ; les portes sous un panneau EXIT
# ramènent parfois au monde ordinaire.
#
# L'ambiance d'un niveau tourne en boucle sur le canal « backrooms » : en
# changeant de niveau, l'ancienne s'éteint en fondu pendant que la nouvelle
# monte ; elle s'éteint aussi en quittant les backrooms.

let level_sounds = {
    level_lobby: "backrooms:backrooms_amb_city",
    level_hotel: "backrooms:backrooms_amb_hotel",
    level_hospital: "backrooms:backrooms_amb_hospital",
    level_parking: "backrooms:backrooms_amb_parking",
    level_pool: "backrooms:backrooms_amb_pool"
}
let details = ["backrooms:backrooms_creak", "backrooms:backrooms_ligh_buzz", "backrooms:backrooms_ventilation",
               "backrooms:backrooms_ventilation_motor", "backrooms:backrooms_drip"]

let channel = "backrooms"
let fade = {fade_in: 4, fade_out: 5}
let current_level = nil   # biome dont l'ambiance joue
let level_check = 0
let detail = 9

fn setting(id) { return math.floor(voxel.setting(id)) }
fn number_of_floors_per_level() { return setting("number_of_floors_per_level") }

fn is_backrooms(dim) { return dim != nil and dim.starts_with("backrooms:") }
fn in_backrooms() { return is_backrooms(world.dimension()) }

voxel.on("dimension_changed", fn(player, to, from) {
    if (to == "backrooms:backrooms" and not is_backrooms(from)) {
        game.say("Vous vous réveillez sur une moquette humide. Le néon grésille. Un ascenseur attend près d'ici ; on dit qu'il descend toujours plus loin.")
    }
    if (is_backrooms(to)) {
        current_level = nil
        level_check = 0
    }
    if (is_backrooms(from) and not is_backrooms(to)) {
        game.say("Les portes se referment derrière vous. L'air est de nouveau respirable.")
        game.stop_ambient(channel, fade.fade_out)
        current_level = nil
    }
})

voxel.system("backrooms_ambience", fn(dt) {
    if (not in_backrooms()) { return nil }
    let players = entity.players()
    if (len(players) == 0) { return nil }
    let p = entity.pos(players[0])
    # Ambiance du niveau : changée seulement quand le niveau change.
    level_check -= dt
    if (level_check <= 0) {
        level_check = 0.5
        let biome = world.biome(p.x, p.z)
        if (biome != current_level) {
            current_level = biome
            let sound = nil
            if (biome != nil and biome.starts_with("backrooms:")) { sound = level_sounds[biome.sub(10)] }
            if (sound != nil) {
                game.ambient(sound, 0.6, {channel: channel, loop: true, fade_in: fade.fade_in, fade_out: fade.fade_out})
            } else {
                game.stop_ambient(channel, fade.fade_out)
            }
        }
    }
    detail -= dt
    if (detail <= 0) {
        detail = 6 + math.random() * 12
        let sound = details[math.floor(math.random() * len(details))]
        game.sound(sound, p.x + math.random() * 16 - 8, p.y + 2, p.z + math.random() * 16 - 8)
    }
})

voxel.on("portal_used", fn(player, to) {
    if (in_backrooms()) {
        let p = entity.pos(player)
        game.sound("backrooms:backrooms_elevator_ding", p.x, p.y + 1, p.z)
    }
    return true
})
