{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Script",
    "scopeName": "source.script",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#declarations" },
        { "include": "#control-flow" },
        { "include": "#oop" },
        { "include": "#async-enum" },
        { "include": "#modules" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#builtins" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.hash.script",
                    "match": "#.*$"
                },
                {
                    "name": "comment.line.double-slash.script",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.script",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.script" } },
                    "endCaptures":   { "0": { "name": "punctuation.definition.comment.end.script" } }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.script",
                    "begin": "\"",
                    "end": "\"",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.script" } },
                    "endCaptures":   { "0": { "name": "punctuation.definition.string.end.script" } },
                    "patterns": [
                        { "name": "constant.character.escape.script", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.single.script",
                    "begin": "'",
                    "end": "'",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.script" } },
                    "endCaptures":   { "0": { "name": "punctuation.definition.string.end.script" } },
                    "patterns": [
                        { "name": "constant.character.escape.script", "match": "\\\\." }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.script",
                    "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.integer.script",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "match": "\\b(let|var|const)\\b",
                    "name": "storage.type.script"
                },
                {
                    "match": "\\bstatic\\b",
                    "name": "storage.modifier.static.script"
                },
                {
                    "match": "\\b(fn|func)\\b(\\s+)([a-zA-Z_\\u0080-\\uFFFF][\\w\\u0080-\\uFFFF]*)",
                    "captures": {
                        "1": { "name": "storage.type.function.script" },
                        "2": { "name": "meta.whitespace.script" },
                        "3": { "name": "entity.name.function.definition.script" }
                    }
                },
                {
                    "match": "\\b(fn|func)\\b(?=\\s*\\()",
                    "name": "storage.type.function.anonymous.script"
                },
                {
                    "match": "\\binit\\b(?=\\s*\\()",
                    "name": "entity.name.function.constructor.script"
                },
                {
                    "match": "\\bdeinit\\b(?=\\s*\\()",
                    "name": "entity.name.function.destructor.script"
                }
            ]
        },
        "control-flow": {
            "patterns": [
                {
                    "match": "\\b(if|else|while|do|for|in|return|break|continue)\\b",
                    "name": "keyword.control.script"
                },
                {
                    "match": "\\b(and|or|not)\\b",
                    "name": "keyword.operator.logical.script"
                }
            ]
        },
        "oop": {
            "patterns": [
                {
                    "match": "\\b(class|interface|abstract|factory|extends|implements|override|new|this|super|is|as|operator)\\b",
                    "name": "keyword.other.oop.script"
                }
            ]
        },
        "async-enum": {
            "patterns": [
                {
                    "match": "\\b(async|await)\\b",
                    "name": "keyword.other.async.script"
                },
                {
                    "match": "\\benum\\b",
                    "name": "storage.type.enum.script"
                }
            ]
        },
        "modules": {
            "patterns": [
                {
                    "match": "\\b(import|require|namespace)\\b",
                    "name": "keyword.control.module.script"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|string|str|any|fn|nil|void|num|list|map|future)\\b",
                    "name": "storage.type.primitive.script"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "match": "\\b(true|false|nil|null)\\b",
                    "name": "constant.language.script"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "match": "\\b(std|math|physics|future)\\b(?=\\s*\\.)",
                    "name": "support.class.builtin.script"
                },
                {
                    "match": "\\b(print|type|assert|len|str|num|list|push|pop|insert|remove|clear|index_of|reverse|sort_numbers|range|map|class_of|keys|values|has|erase|upper|lower|trim|sub|find|replace|starts_with|ends_with|split|join|format|clock|sleep|parse|encode|read_file|write_file|load)\\b(?=\\s*\\()",
                    "name": "support.function.builtin.script"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "match": "(->|<-|<->)",
                    "name": "keyword.operator.flow.script"
                },
                {
                    "match": "(\\.\\.)",
                    "name": "keyword.operator.concatenation.script"
                },
                {
                    "match": "(==|!=|<=|>=|<|>)",
                    "name": "keyword.operator.comparison.script"
                },
                {
                    "match": "(\\+=|-=|\\*=|/=|=)",
                    "name": "keyword.operator.assignment.script"
                },
                {
                    "match": "(\\+|-|\\*|/|%)",
                    "name": "keyword.operator.arithmetic.script"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                { "name": "punctuation.separator.script", "match": "[,;]|\\." },
                { "name": "punctuation.terminator.type.script", "match": ":" },
                { "name": "punctuation.brackets.script", "match": "[(){}\\[\\]]" }
            ]
        }
    }
}