{
    "name": "script-lang",
    "displayName": "Script Language",
    "description": "Coloration, diagnostics, complétion et navigation pour le langage Script.",
    "version": "0.1.0",
    "publisher": "local",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:script"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "script",
                "aliases": [
                    "Script",
                    "script"
                ],
                "extensions": [
                    ".script"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "script",
                "scopeName": "source.script",
                "path": "./syntaxes/script.tmLanguage.json"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p .",
        "watch": "tsc -watch -p .",
        "deploy": "npm run compile && node deploy.js",
        "vscode:prepublish": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.75.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
    }
}
